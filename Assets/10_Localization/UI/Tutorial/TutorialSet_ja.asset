  - m_Id: 175665344512
    m_Localized: "<b>\u60C5\u5831</b>\u30BF\u30D6\u3067\u306F\u3001\u4F53\u529B\u3001\u5185\u529B\u3001\u653B\u6483\u529B\u3001\u9632\u5FA1\u529B\u3092\u306F\u3058\u3081\u3068\u3059\u308B\u80FD\u529B\u5024\u3068\u3001\u7FD2\u5F97\u3057\u305F\u79D8\u4F1D\u66F8\u3092\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175669538816
    m_Localized: "<b>\u5883\u5730</b>\u30BF\u30D6\u3067\u306F\u3001\u73FE\u5728\u306E\u5883\u5730\u3068\u6B21\u306E\u5883\u5730\u3078\u5230\u9054\u3059\u308B\u305F\u3081\u306E\u6761\u4EF6\u3084\u9032\u884C\u72B6\u6CC1\u3092\u78BA\u8A8D\u3057\u3001\u5883\u5730\u4E0A\u6607\u3092\u884C\u3046\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175669538817
    m_Localized: "<b>\u88C5\u5099</b>\u30BF\u30D6\u3067\u306F\u3001\u7372\u5F97\u3057\u305F\u88C5\u5099\u3068\u73FE\u5728\u88C5\u5099\u4E2D\u306E\u88C5\u5099\u3092\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733120
    m_Localized: "<b>\u79D8\u4F1D\u66F8</b>\u30BF\u30D6\u3067\u306F\u3001\u7FD2\u5F97\u3057\u305F\u79D8\u4F1D\u66F8\u3092\u78BA\u8A8D\u3067\u304D\u3001\n\u7372\u5F97\u3057\u305F<b>\u3072\u3089\u3081\u304D</b>\u3092\u4F7F\u7528\u3057\u3066\u79D8\u4F1D\u66F8\u3092\u7814\u7A76\u3057\u3001\u7FD2\u5F97\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733121
    m_Localized: "<b>\u30A2\u30A4\u30C6\u30E0</b>\u30BF\u30D6\u3067\u306F\u3001\u7372\u5F97\u3057\u305F\u6D88\u8017\u54C1\u3084\u5404\u7A2E\u30A2\u30A4\u30C6\u30E0\u3092\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002\n\u7372\u5F97\u3057\u305F\u6D88\u8017\u54C1\u306F\u30AF\u30A4\u30C3\u30AF\u30B9\u30ED\u30C3\u30C8\u306B\u767B\u9332\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733122
    m_Localized: "\u6226\u95D8"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733123
    m_Localized: "\u3059\u3079\u3066\u306E\u653B\u6483\u306F<b>\u5185\u529B</b>\u3092\u6D88\u8CBB\u3057\u307E\u3059\u3002\n\u62DB\u5F0F\u3092\u7E70\u308A\u51FA\u3059\u305F\u3081\u306E\u5185\u529B\u304C\u4E0D\u8DB3\u3057\u3066\u3044\u308B\u5834\u5408\u3001<b>\u653B\u6483\u3059\u308B\u3053\u3068\u306F\u3067\u304D\u307E\u305B\u3093\u3002</b>\n\n\u4F53\u529B\u306F\u5185\u529B\u3068\u306F\u7570\u306A\u308A\u3001<b>\u8868\u793A\u3055\u308C\u307E\u305B\u3093\u3002</b>\n\u5468\u56F2\u304C\u5F90\u3005\u306B\u6697\u304F\u306A\u308B\u3053\u3068\u3067\u3001\u81EA\u8EAB\u306E\u72B6\u614B\u3092\u5224\u65AD\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\n\u4F53\u529B\u304C0\u306B\u306A\u308B\u3068\u6B7B\u4EA1\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733124
    m_Localized: "\u3059\u3079\u3066\u306E\u653B\u6483\u306F<b>\u6B69\u6CD5</b>\u3092\u57FA\u76E4\u3068\u3057\u3066\u3044\u307E\u3059\u3002\n\u5165\u529B\u3057\u305F\u6B69\u6CD5\u306F\u5DE6\u4E0B\u306B\u8868\u793A\u3055\u308C\u3001\u5165\u529B\u3057\u305F\u6B69\u6CD5\u3068\u73FE\u5728\u7FD2\u5F97\u3057\u3066\u3044\u308B\u62DB\u5F0F\u306B\u3088\u3063\u3066\u767A\u52D5\u3059\u308B\u653B\u6483\u304C\u5909\u5316\u3057\u307E\u3059\u3002\n\n\u7FD2\u5F97\u3057\u305F\u62DB\u5F0F\u306F<b>\u30AB\u30D0\u30F3
      - \u79D8\u4F1D\u66F8</b>\u3067\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733125
    m_Localized: "\u6B69\u6CD5\u306F<b>{Action:W}{Action:A}{Action:S}{Action:D}</b>\u3067\u5165\u529B\u3067\u304D\u307E\u3059\u3002\n\u6B69\u6CD5\u3092\u5165\u529B\u3057\u305F\u5F8C\u3001{Action:Attack}\u3067\u653B\u6483\u3092\u5B9F\u884C\u3057\u307E\u3059\u3002\n\u5165\u529B\u3057\u305F\u6B69\u6CD5\u306B\u4E00\u81F4\u3059\u308B\u653B\u6483\u304C\u5B58\u5728\u3057\u306A\u3044\u5834\u5408\u3001<b>\u653B\u6483\u306F\u5B9F\u884C\u3055\u308C\u307E\u305B\u3093\u3002</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 93675870253056
    m_Localized: "\u6226\u95D8\u4E2D\u306F<b>{Action:LockOn}</b>\u3067\u5BFE\u8C61\u306B\u8996\u70B9\u3092\u56FA\u5B9A\u3067\u304D\u307E\u3059\u3002\n\u8996\u70B9\u3092\u56FA\u5B9A\u3057\u3066\u3044\u308B\u9593\u3001<b>{Action:Sprint}</b>\u3092\u62BC\u3059\u3053\u3068\u3067\u4F53\u3092\u3072\u306D\u308A\u3001\u6575\u306E\u653B\u6483\u3092\u56DE\u907F\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8434543521792
    m_Localized: "\u5C01\u5370\u77F3"
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881920
    m_Localized: "\u6C5F\u6E56\u3092\u65C5\u3057\u3066\u3044\u308B\u3068\u3001\u5FD8\u308C\u53BB\u3089\u308C\u305F\u7D76\u4E16\u306E\u9054\u4EBA\u304C\u5C01\u5370\u3055\u308C\u3066\u3044\u308B<b>\u5C01\u5370\u77F3</b>\u3092\u767A\u898B\u3059\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\n\u5C01\u5370\u77F3\u306F\u3069\u3053\u304B\u306B\u96A0\u3055\u308C\u3066\u3044\u305F\u308A\u3001\u8AB0\u304B\u304C\u6240\u6301\u3057\u3066\u3044\u308B\u5834\u5408\u3082\u3042\u308A\u307E\u3059\u3002\n\u3059\u3079\u3066\u306E\u5C01\u5370\u77F3\u3092\u96C6\u3081\u307E\u3057\u3087\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881921
    m_Localized: "\u5C01\u5370\u77F3\u304B\u3089\u805E\u3053\u3048\u308B\u58F0\u306F\u3001\u5931\u308F\u308C\u305F\u5F37\u529B\u306A\u795E\u529F\u3067\u3042\u308B<b>\u6843\u82B1\u529F</b>\u3092\u6388\u3051\u3066\u304F\u308C\u307E\u3057\u305F\u3002\n\u6C5F\u6E56\u884C\u3092\u7D9A\u3051\u3001\u3088\u308A\u9AD8\u3044\u5883\u5730\u3078\u5230\u9054\u3057\u3001\u6843\u82B1\u529F\u306B\u79D8\u3081\u3089\u308C\u305F<b>\u79D8\u4F1D</b>\u3092\u958B\u653E\u3057\u3066\u6D3B\u7528\u3057\u307E\u3057\u3087\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881922
    m_Localized: "<b>\u30AB\u30D0\u30F3 - \u30A2\u30A4\u30C6\u30E0</b>\u304B\u3089\u5C01\u5370\u77F3\u3092\u4F7F\u7528\u3059\u308B\u3068\u3001\n\u5C01\u5370\u77F3\u304B\u3089\u805E\u3053\u3048\u308B\u58F0\u3068\u4F1A\u8A71\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881923
    m_Localized: "\uAC15\uD638\uD589\uC744 \uACC4\uC18D\uD558\uBA70 \uB354 \uB192\uC740
      \uACBD\uC9C0\uC5D0 \uB3C4\uB2EC\uD558\uACE0 \uB3C4\uD654\uACF5\uC5D0 \uB2F4\uAE34
      <b>\uBE44\uC804</b>\uB4E4\uC744 \uAC1C\uBC29\uD558\uACE0 \uD65C\uC6A9\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 100089082703872
    m_Localized: "\u843D\u3068\u3057\u7269"
    m_Metadata:
      m_Items: []
  - m_Id: 100089116258304
    m_Localized: "\u6C5F\u6E56\u3092\u65C5\u3057\u3066\u3044\u308B\u3068\u3001\u6368\u3066\u3089\u308C\u305F\u7269\u3084\u96A0\u3055\u308C\u305F\u30A2\u30A4\u30C6\u30E0\u3092\u767A\u898B\u3059\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\n\u8FD1\u3065\u3044\u3066{Action:Interact}\u30AD\u30FC\u3092\u62BC\u3059\u3068\u3001\u30A2\u30A4\u30C6\u30E0\u3092\u7372\u5F97\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 100089116258305
    m_Localized: "\u307B\u3068\u3093\u3069\u306E\u30A2\u30A4\u30C6\u30E0\u306F\u6C5F\u6E56\u884C\u3092\u3088\u308A\u5FEB\u9069\u306B\u3057\u3066\u304F\u308C\u307E\u3059\u3002\n\u72B6\u6CC1\u306B\u5FDC\u3058\u3066\u6D3B\u7528\u3057\u3066\u307F\u307E\u3057\u3087\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 355180914176000
    m_Localized: "\u64CD\u4F5C"
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924736
    m_Localized: "<b>{Action:W}{Action:A}{Action:S}{Action:D}</b>\u3067\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u3092\u64CD\u4F5C\u3067\u304D\u307E\u3059\u3002\n<b>{Action:Sprint}</b>\u3067\u8D70\u308A\u3001<b>{Action:Walk}</b>\u3067\u6B69\u304F\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\n<b>{Action:Jump}</b>\u3067\u8DF3\u8E8D\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924737
    m_Localized: "<b>{Action:Interact}</b>\u30AD\u30FC\u3067\u3001\u64CD\u4F5C\u53EF\u80FD\u306A\u7269\u306B\u5E72\u6E09\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924738
    m_Localized: "<b>{Action:OpenInventory}</b>\u30AD\u30FC\u3067\u30AB\u30D0\u30F3\u3092\u958B\u9589\u3067\u304D\u307E\u3059\u3002\n\u30AB\u30D0\u30F3\u3067\u306F\u81EA\u8EAB\u306E\u60C5\u5831\u3092\u78BA\u8A8D\u3057\u305F\u308A\u3001\u7372\u5F97\u3057\u305F\u30A2\u30A4\u30C6\u30E0\u3092\u78BA\u8A8D\u3057\u305F\u308A\u3001\u30B2\u30FC\u30E0\u8A2D\u5B9A\u3092\u5909\u66F4\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 15174387682013184
    m_Localized: "<b>{Action:UseQuickSlot}</b>\u3067\u30AF\u30A4\u30C3\u30AF\u30B9\u30ED\u30C3\u30C8\u306B\u767B\u9332\u3057\u305F\u4F7F\u7528\u53EF\u80FD\u30A2\u30A4\u30C6\u30E0\u3092\u4F7F\u7528\u3067\u304D\u307E\u3059\u3002\n<b>{Action:NextQuickSlot}</b>\u3001<b>{Action:PrevQuickSlot}</b>\u3067\u30AF\u30A4\u30C3\u30AF\u30B9\u30ED\u30C3\u30C8\u3092\u5207\u308A\u66FF\u3048\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\n\u30AF\u30A4\u30C3\u30AF\u30B9\u30ED\u30C3\u30C8\u306B\u306F\u6700\u59274\u7A2E\u985E\u306E\u4F7F\u7528\u53EF\u80FD\u30A2\u30A4\u30C6\u30E0\u3092\u767B\u9332\u3067\u304D\u307E\u3059\u3002\n\u4F7F\u7528\u53EF\u80FD\u30A2\u30A4\u30C6\u30E0\u306F<b>\u30AB\u30D0\u30F3
      - \u30A2\u30A4\u30C6\u30E0</b>\u3067\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 15174387707179008
    m_Localized: "\u7D46"
    m_Metadata:
      m_Items: []
  - m_Id: 15174387707179009
    m_Localized: "\u6C5F\u6E56\u884C\u306E\u9014\u4E2D\u3067<b>\u69D8\u3005\u306A\u4EBA\u7269</b>\u3068\u51FA\u4F1A\u3046\u3053\u3068\u306B\u306A\u308A\u307E\u3059\u3002\n\u4EBA\u7269\u305F\u3061\u3068\u4F1A\u8A71\u3057\u3001\u5F7C\u3089\u306E\u8A71\u3092\u805E\u304D\u306A\u304C\u3089\u4EA4\u6D41\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 15174387707179010
    m_Localized: "\u4E00\u90E8\u306E\u4EBA\u7269\u306F\u3042\u306A\u305F\u306B<b>\u983C\u307F\u4E8B</b>\u3092\u3059\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\n\u983C\u307F\u3092\u5F15\u304D\u53D7\u3051\u308B\u304B\u65AD\u308B\u304B\u306F\u3001\u3042\u306A\u305F\u6B21\u7B2C\u3067\u3059\u3002\n\u3057\u304B\u3057\u3001\u983C\u307F\u3092\u53D7\u3051\u3066\u7121\u4E8B\u306B\u89E3\u6C7A\u3059\u308B\u3068<b>\u3055\u3055\u3084\u304B\u306A\u5831\u916C</b>\u3092\u7372\u5F97\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
