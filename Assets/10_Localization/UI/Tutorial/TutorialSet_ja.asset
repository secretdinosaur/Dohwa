  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialSet_ja
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ja
  m_SharedData: {fileID: 11400000, guid: 0dd7028881c51954a93f299e5f23c588, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 175602429952
    m_Localized: "\uAC00\uBC29"
    m_Metadata:
      m_Items: []
  - m_Id: 175665344512
    m_Localized: "<b>\uC815\uBCF4</b> \uD0ED\uC5D0\uC11C\uB294 \uCCB4\uB825, \uB0B4\uB825,
      \uACF5\uACA9\uB825, \uBC29\uC5B4\uB825\uC744 \uBE44\uB86F\uD55C \uB2A5\uB825\uCE58\uC640
      \uC2B5\uB4DD\uD55C \uBE44\uAE09\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 175669538816
    m_Localized: "<b>\uACBD\uC9C0</b> \uD0ED\uC5D0\uC11C\uB294 \uD604\uC7AC \uACBD\uC9C0\uC640
      \uB2E4\uC74C \uACBD\uC9C0\uC5D0 \uC774\uB974\uAE30 \uC704\uD55C \uC870\uAC74
      \uBC0F \uC9C4\uD589 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uACE0 \uACBD\uC9C0
      \uC0C1\uC2B9\uC744 \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 175669538817
    m_Localized: "<b>\uC7A5\uBE44</b>  \uD0ED\uC5D0\uC11C\uB294 \uD68D\uB4DD\uD55C
      \uC7A5\uBE44\uC640, \uD604\uC7AC \uC7A5\uCC29 \uC911\uC778 \uC7A5\uBE44\uB97C
      \uD655\uC778 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 175673733120
    m_Localized: "<b>\uBE44\uAE09</b> \uD0ED\uC5D0\uC11C\uB294 \uC2B5\uB4DD\uD55C
      \uBE44\uAE09\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC73C\uBA70, \n\uD68D\uB4DD\uD55C
      <b>\uAE68\uB2EC\uC74C</b>\uC744 \uC0AC\uC6A9\uD558\uC5EC \uBE44\uAE09\uC744
      \uC5F0\uAD6C\uD558\uACE0 \uC775\uD790 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 175673733121
    m_Localized: "<b>\uBB3C\uAC74</b> \uD0ED\uC5D0\uC11C\uB294 \uD68D\uB4DD\uD55C
      \uC18C\uBAA8\uD488\uACFC \uAC01\uC885 \uBB3C\uAC74\uC744 \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD68D\uB4DD\uD55C \uC18C\uBAA8\uD488\uC740
      \uD035\uC2AC\uB86F\uC5D0 \uB4F1\uB85D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 175673733122
    m_Localized: "\uC804\uD22C"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733123
    m_Localized: "\uB3C4\uD654\uC5D0\uC11C\uC758 \uACF5\uACA9\uC740 <b>\uBCF4\uBC95</b>\uC73C\uB85C
      \uC774\uB8E8\uC5B4\uC9D1\uB2C8\uB2E4.\n\uBC1F\uC740 \uBCF4\uBC95\uC740 \uC88C\uCE21
      \uD558\uB2E8\uC5D0 \uC785\uB825\uB418\uBA70, \uC785\uB825\uD55C \uBCF4\uBC95\uACFC
      \uD604\uC7AC \uC2B5\uB4DD\uD55C \uCD08\uC2DD\uC5D0 \uB530\uB77C \uBC1C\uB3D9\uD558\uB294
      \uACF5\uACA9\uC774 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.\n\uC2B5\uB4DD\uD55C \uCD08\uC2DD\uC740
      <b>\uAC00\uBC29 - \uBE44\uAE09</b>\uC5D0\uC11C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 175673733124
    m_Localized: "\uBCF4\uBC95\uC740 <b>{Action:W}{Action:A}{Action:S}{Action:D}</b>
      \uB97C \uD1B5\uD574 \uC785\uB825\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uACF5\uACA9\uC740
      \uBCF4\uBC95\uC744 \uC785\uB825\uD55C \uB4A4, {Action:Attack}(\uC73C)\uB85C
      \uC2E4\uD589\uD569\uB2C8\uB2E4.\n\uB9CC\uC57D \uC785\uB825\uB41C \uBCF4\uBC95\uACFC
      \uC77C\uCE58\uD558\uB294 \uACF5\uACA9\uC774 \uC5C6\uB2E4\uBA74 <b>\uACF5\uACA9\uC740
      \uC2E4\uD589\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733125
    m_Localized: "\uC804\uD22C \uC911 <b>{Action:LockOn}</b>(\uC744)\uB97C \uD1B5\uD574
      \uB300\uC0C1\uC5D0\uAC8C \uC2DC\uC810\uC744 \uACE0\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC2DC\uC810\uC744
      \uACE0\uC815\uD558\uB294 \uB3C4\uC911 <b>{Action:Sprint}</b> (\uC744)\uB97C
      \uB20C\uB7EC \uBAB8\uC744 \uD2C0\uC5B4 \uC801\uC758 \uACF5\uACA9\uC744 \uD68C\uD53C\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 93675870253056
    m_Localized: "<b>{Action:UseQuickSlot}</b>(\uC73C)\uB85C \uD035\uC2AC\uB86F\uC5D0
      \uB4F1\uB85D\uD55C \uC18C\uBAA8\uD488\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n<b>{Action:NextQuickSlot}</b>,
      <b>{Action:PrevQuickSlot}</b>(\uC73C)\uB85C \uD035\uC2AC\uB86F\uC744 \uD68C\uC804\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD035\uC2AC\uB86F\uC5D0\uB294 \uCD1D 4\uAC00\uC9C0\uC758
      \uC18C\uBAA8\uD488\uC744 \uB4F1\uB85D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC18C\uBAA8\uD488\uC740
      <b>\uAC00\uBC29 - \uBB3C\uAC74</b>\uC5D0\uC11C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8434543521792
    m_Localized: "???\uC758 \uC870\uAC01"
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881920
    m_Localized: "\uB3C4\uD654\uB294 <b>???\uC758 \uC870\uAC01</b>\uC744 \uCC3E\uC544
      \uB5A0\uB098\uB294 \uC5EC\uC815\uC744 \uADF8\uB9BD\uB2C8\uB2E4.\n???\uC758
      \uC870\uAC01\uC740 \uC5B4\uB518\uAC00\uC5D0 \uC228\uACA8\uC838 \uC788\uC744
      \uC218\uB3C4 \uC788\uACE0 \n\uB204\uAD70\uAC00 \uC9C0\uB2C8\uACE0 \uC788\uC744
      \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\n\uBAA8\uB4E0 ???\uC758 \uC870\uAC01\uC744
      \uBAA8\uC73C\uB294 \uAC83\uC774 \uB3C4\uD654\uC5D0\uC11C\uC758 \uBAA9\uD45C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881921
    m_Localized: "???\uC758 \uC870\uAC01\uC5D0\uC11C \uB4E4\uB824\uC624\uB294 \uBAA9\uC18C\uB9AC\uB294
      \uC78A\uD600\uC9C4 \uAC15\uB825\uD55C \uC2E0\uACF5, <b>\uB3C4\uD654\uACF5</b>\uC744
      \uC0AC\uC0AC\uD574\uC8FC\uC5C8\uC2B5\uB2C8\uB2E4.\n\uB3C4\uD654\uACF5\uC758
      \uC2E0\uBB18\uD55C \uD798\uC73C\uB85C \uC774\uC81C <b>\uB3C4\uD654\uBAA9\uC758
      \uBB18\uBAA9</b>\uC744 \uBC1C\uACAC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881922
    m_Localized: "<b>\uB3C4\uD654\uBAA9\uC758 \uBB18\uBAA9</b>\uC740 \uC0C1\uD638\uC791\uC6A9
      \uAC00\uB2A5\uD558\uBA70, \uBAA8\uD5D8\uC744 \uD558\uBA74\uC11C \uC4F0\uB7EC\uC9C0\uAC8C
      \uB418\uBA74, \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC0C1\uD638\uC791\uC6A9\uD55C
      \uB3C4\uD654\uBAA9\uC758 \uBB18\uBAA9\uC5D0\uC11C <b>\uBD80\uD65C</b>\uD558\uAC8C
      \uB429\uB2C8\uB2E4.\n\uB610\uD55C \uC0C1\uD638\uC791\uC6A9 \uD588\uB358 \uB3C4\uD654\uBAA9\uC758
      \uBB18\uBAA9\uB07C\uB9AC <b>\uBE60\uB978 \uC774\uB3D9</b>\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881923
    m_Localized: "\uAC15\uD638\uD589\uC744 \uACC4\uC18D\uD558\uBA70 \uB354 \uB192\uC740
      \uACBD\uC9C0\uC5D0 \uB3C4\uB2EC\uD558\uACE0 \uB3C4\uD654\uACF5\uC5D0 \uB2F4\uAE34
      <b>\uBE44\uC804</b>\uB4E4\uC744 \uAC1C\uBC29\uD558\uACE0 \uD65C\uC6A9\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 100089082703872
    m_Localized: "\uC720\uC2E4\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 100089116258304
    m_Localized: "\uAC15\uD638\uB97C \uB5A0\uB3CC\uB2E4 \uBCF4\uBA74 \uBC84\uB824\uC9C0\uAC70\uB098
      \uC228\uACA8\uC9C4 \uBB3C\uAC74\uC744 \uBC1C\uACAC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAC00\uAE4C\uC774
      \uC811\uADFC\uD558\uC5EC {Action:Interact} \uD0A4\uB97C \uB204\uB974\uBA74
      \uBB3C\uAC74\uC744 \uD68D\uB4DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 100089116258305
    m_Localized: "\uB300\uBD80\uBD84\uC758 \uBB3C\uAC74\uC740 \uAC15\uD638\uD589\uC744
      \uB354\uC6B1 \uC218\uC6D4\uD558\uAC8C \uB9CC\uB4E4\uC5B4 \uC90D\uB2C8\uB2E4.
      \uC0C1\uD669\uC5D0 \uB9DE\uAC8C \uD65C\uC6A9\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 355180914176000
    m_Localized: "\uC870\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924736
    m_Localized: "<b>{Action:W}{Action:A}{Action:S}{Action:D}</b>\uB85C \uCE90\uB9AD\uD130\uB97C
      \uC6C0\uC9C1\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n<b>{Action:Sprint}</b>\uB85C
      \uB2EC\uB9AC\uACE0 <b>{Action:Walk}</b>\uB85C \uAC78\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n<b>{Action:Jump}</b>\uB85C
      \uB3C4\uC57D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924737
    m_Localized: "<b>{Action:Interact}</b> \uD0A4\uB85C \uC0C1\uD638\uC791\uC6A9
      \uAC00\uB2A5\uD55C \uBB3C\uAC74\uB4E4\uC5D0 \uC0C1\uD638\uC791\uC6A9 \uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924738
    m_Localized: "<b>{Action:OpenInventory}</b> \uD0A4\uB85C \uAC00\uBC29\uC744 \uC5F4\uACE0
      \uB2EB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAC00\uBC29\uC5D0\uC11C\uB294
      \uC790\uC2E0\uC758 \uC815\uBCF4\uB97C \uD655\uC778\uD558\uAC70\uB098 \uD68D\uB4DD\uD55C
      \uBB3C\uD488\uC744 \uD655\uC778\uD560 \uC218 \uC788\uACE0 \n\uAC8C\uC784 \uC124\uC815\uC744
      \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
