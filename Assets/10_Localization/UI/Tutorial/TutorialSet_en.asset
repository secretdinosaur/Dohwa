  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialSet_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 0dd7028881c51954a93f299e5f23c588, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 175602429952
    m_Localized: Bag
    m_Metadata:
      m_Items: []
  - m_Id: 175673733122
    m_Localized: Battle
    m_Metadata:
      m_Items: []
  - m_Id: 8434543521792
    m_Localized: The Sealing Stone
    m_Metadata:
      m_Items: []
  - m_Id: 100089082703872
    m_Localized: Lost Item
    m_Metadata:
      m_Items: []
  - m_Id: 175665344512
    m_Localized: The <b>Status</b> tab displays your Health, Internal Energy, ATK,
      DEF, and other attributes, as well as the Manuals you have obtained.
    m_Metadata:
      m_Items: []
  - m_Id: 175669538816
    m_Localized: The <b>Realm</b> tab shows your current Realm, the requirements
      for advancing to the next Realm, your progress, and allows you to advance when
      the conditions are met.
    m_Metadata:
      m_Items: []
  - m_Id: 175669538817
    m_Localized: The <b>Equipment</b> tab displays the equipment you have obtained
      and the gear you currently have equipped.
    m_Metadata:
      m_Items: []
  - m_Id: 175673733120
    m_Localized: 'The <b>Secret Manual</b> tab displays the Secret Manual you have
      obtained.

      You can spend <b>Insight</b> to study and master them.'
    m_Metadata:
      m_Items: []
  - m_Id: 175673733121
    m_Localized: 'The <b>Item</b> tab displays consumables and other items you have
      obtained.

      Usable items can be assigned to Quick Slots'
    m_Metadata:
      m_Items: []
  - m_Id: 175673733123
    m_Localized: 'Every attack consumes <b>Inner Qi</b>.

      If you do not have
      enough Inner Qi to perform a stance, <b>you cannot attack.</b>


      Unlike
      Inner Qi, <b>Health is not displayed.</b>

      Instead, you must judge your
      condition by watching your surroundings gradually grow darker.

      You will
      die when your Health reaches 0.'
    m_Metadata:
      m_Items: []
  - m_Id: 175673733124
    m_Localized: 'All the attacks are based on <b>Footwork</b>.

      Your inputted
      Footwork is displayed in the lower-left corner, and the attack that is executed
      depends on the Footwork you entered and the Stances you have learned.


      You
      can view your learned Stances in <b>Inventory - Secret Manual</b>.'
    m_Metadata:
      m_Items: []
  - m_Id: 175673733125
    m_Localized: 'You can input Footwork using <b>{Action:W}{Action:A}{Action:S}{Action:D}</b>.

      After
      entering a Footwork pattern, press {Action:Attack} to attack.

      If no
      attack matches the entered Footwork, <b>the attack will not be executed.</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 93675870253056
    m_Localized: 'During combat, press <b>{Action:LockOn}</b> to lock your view onto
      a target.

      While locked on, press <b>{Action:Sprint}</b> to pivot your
      body and evade incoming attacks.'
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881920
    m_Localized: 'During your journey through the Jianghu, you may discover <b>The
      Sealing Stone</b>, which seals away a forgotten peerless master.

      It
      may be hidden somewhere or carried by someone.

      Collect every Sealing
      Stone.'
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881921
    m_Localized: 'The voice within the <b>The Sealing Stone</b> has passed down the
      forgotten Divine Art, the <b>Peach Blossom Art</b>.

      Continue your journey,
      reach higher Realms, and unlock and master the <b>Secret Arts</b> hidden within
      the Peach Blossom Art.'
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881922
    m_Localized: 'Use <b>Inventory - Item</b> to use the Sealing Stone

      and
      speak with the voice sealed within it.'
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881923
    m_Localized: "\uAC15\uD638\uD589\uC744 \uACC4\uC18D\uD558\uBA70 \uB354 \uB192\uC740
      \uACBD\uC9C0\uC5D0 \uB3C4\uB2EC\uD558\uACE0 \uB3C4\uD654\uACF5\uC5D0 \uB2F4\uAE34
      <b>\uBE44\uC804</b>\uB4E4\uC744 \uAC1C\uBC29\uD558\uACE0 \uD65C\uC6A9\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 100089116258304
    m_Localized: 'While traveling through the Jianghu, you may come across abandoned
      or hidden items.

      Approach them and press {Action:Interact} to pick them
      up.'
    m_Metadata:
      m_Items: []
  - m_Id: 100089116258305
    m_Localized: 'Most items will make your journey through the Jianghu easier.

      Use
      them wisely according to the situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 355180914176000
    m_Localized: Move
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924736
    m_Localized: '<b>{Action:W}{Action:A}{Action:S}{Action:D}</b> to move your character.

      Press
      <b>{Action:Sprint}</b> to sprint, <b>{Action:Walk}</b> to walk,

      and
      <b>{Action:Jump}</b> to jump.'
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924737
    m_Localized: Press <b>{Action:Interact}</b> to interact with nearby objects.
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924738
    m_Localized: 'Press <b>{Action:OpenInventory}</b> to open or close your Inventory.

      From
      the Inventory, you can view your Status, check the items you have obtained,
      and adjust the game settings.'
    m_Metadata:
      m_Items: []
  - m_Id: 15174387682013184
    m_Localized: During combat, when the opponent's Inner Qi reaches 0, you can use
      {Action:Attack} to perform a <b>Powerful Attack</b>.
    m_Metadata:
      m_Items: []
  - m_Id: 15174387707179008
    m_Localized: Connections
    m_Metadata:
      m_Items: []
  - m_Id: 15174387707179009
    m_Localized: 'During your journey through the Jianghu, you will encounter <b>various
      characters</b>.

      You can talk with them, listen to their stories, and
      interact with them.'
    m_Metadata:
      m_Items: []
  - m_Id: 15174387707179010
    m_Localized: 'Some characters may ask you for <b>requests</b>.

      Whether
      you accept or refuse their requests is up to you.

      However, if you accept
      a request and successfully complete it, you can receive <b>small rewards</b>.'
    m_Metadata:
      m_Items: []
  - m_Id: 22480928888913920
    m_Localized: 'Press <b>{Action:UseQuickSlot}</b> to use the Consumable assigned
      to Quick Slot.

      Use <b>{Action:NextQuickSlot}</b> and <b>{Action:PrevQuickSlot}</b>
      to cycle through Quick Slots.

      Up to four Usable Items can be assigned
      to the Quick Slot.

      You can view your Usable Items in <b>Inventory -
      Item</b>.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
