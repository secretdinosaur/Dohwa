  m_TableData:
  - m_Id: 175602429952
    m_Localized: "\u80CC\u5305"
    m_Metadata:
      m_Items: []
  - m_Id: 175665344512
    m_Localized: "<b>\u72B6\u6001</b>\u6807\u7B7E\u4E2D\uFF0C\u53EF\u4EE5\u67E5\u770B\u5305\u62EC\u4F53\u529B\u3001\u5185\u529B\u3001\u653B\u51FB\u529B\u3001\u9632\u5FA1\u529B\u5728\u5185\u7684\u5C5E\u6027\uFF0C\u4EE5\u53CA\u5DF2\u4E60\u5F97\u7684\u79D8\u7B08\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175669538816
    m_Localized: "<b>\u5883\u754C</b>\u6807\u7B7E\u4E2D\uFF0C\u53EF\u4EE5\u67E5\u770B\u5F53\u524D\u5883\u754C\u3001\u63D0\u5347\u81F3\u4E0B\u4E00\u5883\u754C\u6240\u9700\u7684\u6761\u4EF6\u4EE5\u53CA\u8FDB\u5EA6\uFF0C\u5E76\u8FDB\u884C\u5883\u754C\u63D0\u5347\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175669538817
    m_Localized: "<b>\u88C5\u5907</b>\u6807\u7B7E\u4E2D\uFF0C\u53EF\u4EE5\u67E5\u770B\u5DF2\u83B7\u5F97\u7684\u88C5\u5907\u4EE5\u53CA\u5F53\u524D\u88C5\u5907\u4E2D\u7684\u88C5\u5907\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733120
    m_Localized: "<b>\u79D8\u7B08</b>\u6807\u7B7E\u4E2D\uFF0C\u53EF\u4EE5\u67E5\u770B\u5DF2\u4E60\u5F97\u7684\u79D8\u7B08\uFF0C\n\u5E76\u4F7F\u7528\u83B7\u5F97\u7684<b>\u611F\u609F</b>\u7814\u7A76\u548C\u4FEE\u70BC\u79D8\u7B08\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733121
    m_Localized: "<b>\u7269\u54C1</b>\u6807\u7B7E\u4E2D\uFF0C\u53EF\u4EE5\u67E5\u770B\u5DF2\u83B7\u5F97\u7684\u6D88\u8017\u54C1\u4EE5\u53CA\u5404\u79CD\u7269\u54C1\u3002\n\u83B7\u5F97\u7684\u6D88\u8017\u54C1\u53EF\u4EE5\u767B\u8BB0\u81F3\u5FEB\u6377\u680F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733122
    m_Localized: "\u6218\u6597"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733123
    m_Localized: "\u6240\u6709\u653B\u51FB\u90FD\u4F1A\u6D88\u8017<b>\u5185\u529B</b>\u3002\n\u5982\u679C\u6CA1\u6709\u8DB3\u591F\u65BD\u5C55\u62DB\u5F0F\u7684\u5185\u529B\uFF0C<b>\u65E0\u6CD5\u8FDB\u884C\u653B\u51FB\u3002</b>\n\n\u4E0E\u5185\u529B\u4E0D\u540C\uFF0C\u4F53\u529B<b>\u4E0D\u4F1A\u663E\u793A\u3002</b>\n\u4F60\u9700\u8981\u901A\u8FC7\u5468\u56F4\u73AF\u5883\u9010\u6E10\u53D8\u6697\u7684\u53D8\u5316\u6765\u5224\u65AD\u81EA\u8EAB\u72B6\u6001\u3002\n\u4F53\u529B\u5F52\u96F6\u65F6\u5C06\u4F1A\u6B7B\u4EA1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733124
    m_Localized: "\u6240\u6709\u653B\u51FB\u90FD\u4EE5<b>\u62DB\u5F0F</b>\u4E3A\u57FA\u7840\u3002\n\u8F93\u5165\u7684\u62DB\u5F0F\u4F1A\u663E\u793A\u5728\u5DE6\u4E0B\u89D2\uFF0C\u53D1\u52A8\u7684\u653B\u51FB\u4F1A\u6839\u636E\u8F93\u5165\u7684\u62DB\u5F0F\u4EE5\u53CA\u5F53\u524D\u4E60\u5F97\u7684\u62DB\u5F0F\u800C\u53D8\u5316\u3002\n\n\u5DF2\u4E60\u5F97\u7684\u62DB\u5F0F\u53EF\u4EE5\u5728<b>\u80CC\u5305
      - \u79D8\u7B08</b>\u4E2D\u67E5\u770B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 175673733125
    m_Localized: "\u53EF\u4EE5\u901A\u8FC7<b>{Action:W}{Action:A}{Action:S}{Action:D}</b>\u8F93\u5165\u62DB\u5F0F\u3002\n\u8F93\u5165\u62DB\u5F0F\u540E\uFF0C\u4F7F\u7528{Action:Attack}\u6267\u884C\u653B\u51FB\u3002\n\u5982\u679C\u6CA1\u6709\u4E0E\u8F93\u5165\u62DB\u5F0F\u76F8\u5339\u914D\u7684\u653B\u51FB\uFF0C<b>\u653B\u51FB\u5C06\u4E0D\u4F1A\u53D1\u52A8\u3002</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 93675870253056
    m_Localized: "\u6218\u6597\u4E2D\uFF0C\u53EF\u4EE5\u901A\u8FC7<b>{Action:LockOn}</b>\u9501\u5B9A\u76EE\u6807\u89C6\u89D2\u3002\n\u9501\u5B9A\u89C6\u89D2\u65F6\uFF0C\u6309\u4E0B<b>{Action:Sprint}</b>\u53EF\u4EE5\u8F6C\u8EAB\u8EB2\u907F\u654C\u4EBA\u7684\u653B\u51FB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8434543521792
    m_Localized: "\u5C01\u5370\u77F3"
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881920
    m_Localized: "\u5728\u95EF\u8361\u6C5F\u6E56\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u4F60\u53EF\u80FD\u4F1A\u53D1\u73B0\u5C01\u5370\u7740\u88AB\u9057\u5FD8\u7684\u7EDD\u4E16\u9AD8\u624B\u7684<b>\u5C01\u5370\u77F3</b>\u3002\n\u5C01\u5370\u77F3\u53EF\u80FD\u9690\u85CF\u5728\u67D0\u5904\uFF0C\u4E5F\u53EF\u80FD\u88AB\u67D0\u4E2A\u4EBA\u6301\u6709\u3002\n\u6536\u96C6\u6240\u6709\u5C01\u5370\u77F3\u5427\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881921
    m_Localized: "\u5C01\u5370\u77F3\u4E2D\u4F20\u6765\u7684\u58F0\u97F3\u4F20\u6388\u4E86\u5931\u4F20\u5DF2\u4E45\u7684\u5F3A\u5927\u795E\u529F\u2014\u2014<b>\u6843\u82B1\u529F</b>\u3002\n\u7EE7\u7EED\u95EF\u8361\u6C5F\u6E56\uFF0C\u8FBE\u5230\u66F4\u9AD8\u7684\u5883\u754C\uFF0C\u5E76\u89E3\u9501\u548C\u8FD0\u7528\u6843\u82B1\u529F\u4E2D\u8574\u542B\u7684<b>\u79D8\u4F20</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881922
    m_Localized: "\u5728<b>\u80CC\u5305 - \u7269\u54C1</b>\u4E2D\u4F7F\u7528\u5C01\u5370\u77F3\uFF0C\n\u5373\u53EF\u4E0E\u5C01\u5370\u77F3\u4E2D\u4F20\u6765\u7684\u58F0\u97F3\u8FDB\u884C\u5BF9\u8BDD\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8434572881923
    m_Localized: "\uAC15\uD638\uD589\uC744 \uACC4\uC18D\uD558\uBA70 \uB354 \uB192\uC740
      \uACBD\uC9C0\uC5D0 \uB3C4\uB2EC\uD558\uACE0 \uB3C4\uD654\uACF5\uC5D0 \uB2F4\uAE34
      <b>\uBE44\uC804</b>\uB4E4\uC744 \uAC1C\uBC29\uD558\uACE0 \uD65C\uC6A9\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 100089082703872
    m_Localized: "\u9057\u5931\u7269"
    m_Metadata:
      m_Items: []
  - m_Id: 100089116258304
    m_Localized: "\u5728\u95EF\u8361\u6C5F\u6E56\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u4F60\u53EF\u80FD\u4F1A\u53D1\u73B0\u88AB\u9057\u5F03\u6216\u9690\u85CF\u7684\u7269\u54C1\u3002\n\u9760\u8FD1\u540E\u6309\u4E0B{Action:Interact}\u952E\uFF0C\u5373\u53EF\u83B7\u5F97\u7269\u54C1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 100089116258305
    m_Localized: "\u5927\u591A\u6570\u7269\u54C1\u90FD\u80FD\u8BA9\u4F60\u7684\u6C5F\u6E56\u4E4B\u884C\u66F4\u52A0\u987A\u5229\u3002\n\u8BF7\u6839\u636E\u60C5\u51B5\u7075\u6D3B\u4F7F\u7528\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 355180914176000
    m_Localized: "\u64CD\u4F5C"
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924736
    m_Localized: "\u901A\u8FC7<b>{Action:W}{Action:A}{Action:S}{Action:D}</b>\u53EF\u4EE5\u79FB\u52A8\u89D2\u8272\u3002\n\u4F7F\u7528<b>{Action:Sprint}</b>\u53EF\u4EE5\u5954\u8DD1\uFF0C\u4F7F\u7528<b>{Action:Walk}</b>\u53EF\u4EE5\u884C\u8D70\u3002\n\u4F7F\u7528<b>{Action:Jump}</b>\u53EF\u4EE5\u8FDB\u884C\u8DF3\u8DC3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924737
    m_Localized: "\u6309\u4E0B<b>{Action:Interact}</b>\u952E\uFF0C\u53EF\u4EE5\u4E0E\u53EF\u4E92\u52A8\u7684\u7269\u54C1\u8FDB\u884C\u4E92\u52A8\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 355180951924738
    m_Localized: "\u6309\u4E0B<b>{Action:OpenInventory}</b>\u952E\uFF0C\u53EF\u4EE5\u6253\u5F00\u6216\u5173\u95ED\u80CC\u5305\u3002\n\u5728\u80CC\u5305\u4E2D\uFF0C\u53EF\u4EE5\u67E5\u770B\u81EA\u5DF1\u7684\u4FE1\u606F\u3001\u5DF2\u83B7\u5F97\u7684\u7269\u54C1\uFF0C\u4EE5\u53CA\u8FDB\u884C\u6E38\u620F\u8BBE\u7F6E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 15174387682013184
    m_Localized: "\u6218\u6597\u4E2D\uFF0C\u5F53\u5BF9\u624B\u7684\u5185\u529B\u964D\u4E3A0\u65F6\uFF0C\u53EF\u4EE5\u4F7F\u7528{Action:Attack}\u53D1\u52A8<b>\u5F3A\u529B\u653B\u51FB</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 15174387707179008
    m_Localized: "\u7F18\u5206"
    m_Metadata:
      m_Items: []
  - m_Id: 15174387707179009
    m_Localized: "\u5728\u95EF\u8361\u6C5F\u6E56\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u4F60\u4F1A\u9047\u5230<b>\u5404\u79CD\u4EBA\u7269</b>\u3002\n\u53EF\u4EE5\u4E0E\u4ED6\u4EEC\u4EA4\u8C08\uFF0C\u8046\u542C\u4ED6\u4EEC\u7684\u6545\u4E8B\uFF0C\u5E76\u4E0E\u4ED6\u4EEC\u4EA4\u6D41\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 15174387707179010
    m_Localized: "\u90E8\u5206\u4EBA\u7269\u4F1A\u5411\u4F60\u63D0\u51FA<b>\u8BF7\u6C42</b>\u3002\n\u662F\u5426\u63A5\u53D7\u6216\u62D2\u7EDD\u8BF7\u6C42\uFF0C\u7531\u4F60\u81EA\u884C\u51B3\u5B9A\u3002\n\u4F46\u662F\uFF0C\u63A5\u53D7\u8BF7\u6C42\u5E76\u6210\u529F\u89E3\u51B3\u540E\uFF0C\u53EF\u4EE5\u83B7\u5F97<b>\u5C0F\u5C0F\u7684\u5956\u52B1</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22480928888913920
    m_Localized: "\u4F7F\u7528<b>{Action:UseQuickSlot}</b>\u53EF\u4EE5\u4F7F\u7528\u767B\u8BB0\u5728\u5FEB\u6377\u680F\u4E2D\u7684\u53EF\u4F7F\u7528\u7269\u54C1\u3002\n\u901A\u8FC7<b>{Action:NextQuickSlot}</b>\u3001<b>{Action:PrevQuickSlot}</b>\u53EF\u4EE5\u5207\u6362\u5FEB\u6377\u680F\u3002\n\u5FEB\u6377\u680F\u6700\u591A\u53EF\u4EE5\u767B\u8BB04\u79CD\u53EF\u4F7F\u7528\u7269\u54C1\u3002\n\u53EF\u4F7F\u7528\u7269\u54C1\u53EF\u4EE5\u5728<b>\u80CC\u5305
      - \u7269\u54C1</b>\u4E2D\u67E5\u770B\u3002"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
