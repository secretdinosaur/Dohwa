  m_TableData:
  - m_Id: 808879419392
    m_Localized: "\uACBD\uC544.\n\n\uC544\uBC84\uC9C0\uAC00 \uACC1\uC5D0 \uC5C6\uB354\uB77C\uB3C4
      \uBC25\uC740 \uAF2D \uCC59\uACA8 \uBA39\uAC70\uB77C.\n\uB0A8\uC744 \uC18D\uC774\uC9C0
      \uB9D0\uACE0, \uC5B4\uB824\uC6B4 \uC774\uB97C \uC9C0\uB098\uCE58\uC9C0 \uB9C8\uB77C.\n\uADF8\uAC70\uBA74
      \uC544\uBC84\uC9C0\uB294 \uB354 \uBC14\uB784 \uAC83\uC774 \uC5C6\uB2E4.\n\n\uB298
      \uB124\uAC00 \uC790\uB791\uC2A4\uB7FD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 327833326481408
    m_Localized: "\uC0AC\uBD80\uB2D8\uAED8.\n\n\uCCAD\uD48D\uCD0C\uC5D0\uC11C \uC870\uAC01\uC744
      \uBC1C\uACAC\uD588\uB2E4\uB294 \uCCA9\uBCF4\uB294 \n\uC0AC\uC2E4\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uC758\uC2EC\uC744
      \uD53C\uD558\uAE30 \uC704\uD574 \uB179\uB9BC\uCC44\uB97C \uC0AC\uC8FC\uD558\uC5EC
      \n\uCCAD\uD48D\uCD0C\uC744 \uC2B5\uACA9\uD558\uAC8C \uD588\uC2B5\uB2C8\uB2E4.\n\n\uBB34\uB9BC\uB9F9
      \uB610\uD55C \uB179\uB9BC\uB3C4\uB4E4\uC758 \uC18C\uD589\uC73C\uB85C \n\uACB0\uB860\uC9C0\uC744
      \uAC83\uC785\uB2C8\uB2E4.\n\n\uB2E4\uB9CC \uC870\uAC01\uC740 \uC544\uC9C1 \uCC3E\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4.\n\n\uC870\uAC01\uC744 \uD68C\uC218\uD55C \uB4A4\uC5D0,
      \uB179\uB9BC\uCC44 \uB610\uD55C \n\uD754\uC801 \uC5C6\uC774 \uC815\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 327833376813056
    m_Localized: "\uD615\uB2D8\uC774 \uC774\uC0C1\uD574.\n\n\uAC70\uCE5C \uC0AC\uB78C\uC774\uAE34
      \uD588\uC5B4\uB3C4, \n\uC800\uB807\uAC8C \uD53C\uC5D0 \uBBF8\uCE5C \uAD11\uC778\uC740
      \uC544\uB2C8\uC5C8\uB294\uB370.\n\n\uADF8 \uC870\uAC01 \uB54C\uBB38\uC778 \uAC83
      \uAC19\uC544."
    m_Metadata:
      m_Items: []
