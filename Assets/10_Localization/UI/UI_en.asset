  - m_Id: 62999186045730816
    m_Localized: Credit
    m_Metadata:
      m_Items: []
  - m_Id: 63056889826013184
    m_Localized: Continue
    m_Metadata:
      m_Items: []
  - m_Id: 63082291948711936
    m_Localized: 'The maximum Health that can be restored.

      You will die when
      Health reaches 0.'
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654976
    m_Localized: 'The maximum Inner Qi that can be restored.

      Used for actions
      such as running and attacking.'
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654977
    m_Localized: Affects Move Speed.
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654978
    m_Localized: Affects Health recovery speed.
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654979
    m_Localized: Affects Qi recovery speed.
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654980
    m_Localized: 'Affects the following stats:

      <color=green>Max Health</color>,
      <color=green>Defense</color>,

      Max Qi, Attack'
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654981
    m_Localized: 'Affects the following stats:

      Max Health, Defense,

      <color=green>Max
      Qi</color>, <color=green>Attack</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654982
    m_Localized: The probability of striking an opponent's vital point.
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654983
    m_Localized: "When landing a strike on an opponent's vital point, \naffects the
      amount of damage dealt."
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654984
    m_Localized: Reduces poison damage.
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654985
    m_Localized: Reduces bleed damage.
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654986
    m_Localized: Reduces fire damage.
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654987
    m_Localized: Reduces lightning damage.
    m_Metadata:
      m_Items: []
  - m_Id: 63082291990654988
    m_Localized: Represents Orthodox inclination.
    m_Metadata:
      m_Items: []
  - m_Id: 63082292007432192
    m_Localized: Represents Unorthodox inclination.
    m_Metadata:
      m_Items: []
  - m_Id: 63082292007432193
    m_Localized: Represents Demonic inclination.
    m_Metadata:
      m_Items: []
  - m_Id: 63082292007432194
    m_Localized: "For all actions that consume Qi, \nreduces the amount of Qi consumed."
    m_Metadata:
      m_Items: []
  - m_Id: 63084894984105984
    m_Localized: "Increases damage dealt \nwhen attacking an opponent."
    m_Metadata:
      m_Items: []
  - m_Id: 63084894984105985
    m_Localized: "Reduces damage taken \nwhen attacked by an opponent."
    m_Metadata:
      m_Items: []
