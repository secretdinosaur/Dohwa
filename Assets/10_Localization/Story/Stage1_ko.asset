%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Stage1_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 61a814adaef47034caf20ca9112a92aa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 275351367680
    m_Localized: "\uC740\uC778, \uC18C\uC778\uC758 \uBBF8\uCC9C\uD55C \uBAA9\uC228\uC744
      \uAD6C\uD574\uC8FC\uC154\uC11C \uAC10\uACA9\uD560 \uB530\uB984\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 275418476544
    m_Localized: "\uC18C\uC778\uC740 \uC0AC\uACF5 \uC77C\uC744 \uD558\uACE0\uC788\uB294
      \uC2EC\uBAA8\uB77C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 275418476545
    m_Localized: "\uD639\uC2DC \uC740\uC778\uC758 \uC131\uD568\uC744 \uB4E4\uC744
      \uC218 \uC788\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 275418476546
    m_Localized: "\uC740\uC778, \uAC15\uC744 \uAC74\uB108\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 275418476547
    m_Localized: "\uC774 \uC2EC\uBAA8\uC758 \uBAA9\uC228\uC774 \uBD99\uC5B4\uC788\uB294
      \uD55C, \uC740\uC778\uC758 \uC131\uD568\uC744 \uC78A\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 275418476548
    m_Localized: "\uC774 \uAC15\uC744 \uAC74\uB108\uC2E4 \uB54C\uB294 \uC800\uB97C
      \uCC3E\uC544\uC8FC\uC2ED\uC1FC. \n\uC740\uC778\uAED8 \uBC43\uC0AF\uC744 \uBC1B\uB294\uB2E4\uBA74
      \uCC9C\uBC8C\uC744 \uBC1B\uC744 \uB188\uC774\uB2C8, \uC5B8\uC81C\uB4E0 \uBB34\uC784\uC73C\uB85C
      \uBAA8\uC2DC\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 275418476549
    m_Localized: "\uC740\uC778\uC758 \uC131\uD568\uC744 \uB4E3\uC9C0 \uBABB\uD55C
      \uAC83\uC740 \uC544\uC26C\uC6B0\uB098, \uC740\uC778\uC758 \uC6A9\uBAA8\uB9CC\uD07C\uC740
      \uC81C \uB208\uC5D0 \uB611\uB611\uD788 \uC0C8\uACBC\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 275418476550
    m_Localized: "\uC774 \uAC15\uC744 \uAC74\uB108\uC2E4 \uB54C\uB294 \uC800\uB97C
      \uCC3E\uC544\uC8FC\uC2ED\uC1FC. \n\uC740\uC778\uAED8 \uBC43\uC0AF\uC744 \uBC1B\uB294\uB2E4\uBA74
      \uCC9C\uBC8C\uC744 \uBC1B\uC744 \uB188\uC774\uB2C8, \uC5B8\uC81C\uB4E0 \uBB34\uC784\uC73C\uB85C
      \uBAA8\uC2DC\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 275418476551
    m_Localized: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4 \uC740\uC778. \n\uC9C0\uAE08 \uBC14\uB85C
      \uBC30\uB97C \uB744\uC6B0\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 275418476552
    m_Localized: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4 \uC740\uC778. \n\uB9CC\uC57D \uAC15\uC744
      \uAC74\uB108\uACE0 \uC2F6\uC73C\uC2DC\uB2E4\uBA74, \uC800\uC5D0\uAC8C \uB9D0\uC500\uD574\uC8FC\uC2DC\uBA74
      \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 275418476553
    m_Localized: "\uC54C\uB824\uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 275418476554
    m_Localized: "\uC54C\uB824\uC8FC\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 275418476555
    m_Localized: "\uAC74\uB10C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 275418476556
    m_Localized: "\uAC74\uB108\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226025862098944
    m_Localized: "...\uADF8\uB300\uAC00.. \uBCF8\uC88C\uB97C.. \uAE68\uC6E0\uB294\uAC00.."
    m_Metadata:
      m_Items: []
  - m_Id: 226025908236288
    m_Localized: "...\uB3C4\uD654\uACF5... \uBCF8\uC88C\uC758... \uBB34\uACF5\uC744...
      \uC0AC\uC0AC\uD558\uC5EC.. \uBCF8\uC88C\uC758.. \uC81C\uC790\uB85C.."
    m_Metadata:
      m_Items: []
  - m_Id: 226025908236289
    m_Localized: "...\uCC3E\uC544\uB77C..."
    m_Metadata:
      m_Items: []
  - m_Id: 226025908236290
    m_Localized: "...\uBCF8\uC88C\uC758... \uC870\uAC01\uC744..."
    m_Metadata:
      m_Items: []
  - m_Id: 226025908236291
    m_Localized: "...\uC815\uC0C1\uC73C\uB85C..."
    m_Metadata:
      m_Items: []
  - m_Id: 226025908236292
    m_Localized: "...\uC0B0\uC758 \uC815\uC0C1\uC73C\uB85C..."
    m_Metadata:
      m_Items: []
  - m_Id: 226025908236293
    m_Localized: "...\uADF8\uACF3\uC5D0... \uBCF8\uC88C\uC758 \uC870\uAC01\uC774..."
    m_Metadata:
      m_Items: []
  - m_Id: 1365207777136640
    m_Localized: "..\uC624\uC624.. \uD798\uC774.. \uD798\uC774 \uB3CC\uC544\uC624\uB294
      \uAC83\uC774.. \uB290\uAEF4\uC9C0\uB294\uAD6C\uB098.."
    m_Metadata:
      m_Items: []
  - m_Id: 1365207814885376
    m_Localized: "..\uB2E4\uC74C \uC870\uAC01\uC740.. \uC800\uB108\uBA38\uC5D0\uC11C..
      \uB290\uAEF4\uC9C4\uB2E4.."
    m_Metadata:
      m_Items: []
  - m_Id: 1365207814885377
    m_Localized: "..\uAC15\uC744 \uAC74\uB108\uAC70\uB77C.. \uBCF8\uC88C\uC758 \uC81C\uC790\uC57C.."
    m_Metadata:
      m_Items: []
  - m_Id: 1365207814885378
    m_Localized: "...\uBCF8\uC88C\uC758... \uC870\uAC01\uC744... \uCC3E\uC544\uB2E4\uC624..."
    m_Metadata:
      m_Items: []
  - m_Id: 9341273091198976
    m_Localized: "...\uC544\uC800\uC528...\n...\uC6B0\uB9AC \uC544\uBE60\uAC00 \uC0B0\uC801\uB4E4\uC774\uB791
      \uC2F8\uC6B0\uB7EC \uAC14\uC5B4\uC694.."
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781888
    m_Localized: "...\uBD80\uD0C1\uB4DC\uB824\uC694.. \uC81C\uBC1C..\n...\uC81C\uBC1C
      \uC6B0\uB9AC \uC544\uBE60\uB97C \uB3C4\uC640\uC8FC\uC138\uC694.."
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781889
    m_Localized: "\uB3C4\uC640\uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781890
    m_Localized: "\uB3C4\uC640\uC8FC\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781891
    m_Localized: "...\uAC10\uC0AC\uD569\uB2C8\uB2E4.\n\uC544\uBE60\uB294 \uB9C8\uC744
      \uC548\uCABD\uC5D0 \uACC4\uC2E4\uAC70\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781892
    m_Localized: "...\uC870\uC2EC\uD574\uC11C \uAC00\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781893
    m_Localized: "\uC544\uBE60.."
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781894
    m_Localized: "\uC544\uBE60\uB294 \uB9C8\uC744 \uC548\uCABD\uC5D0 \uACC4\uC2E4\uAC70\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781895
    m_Localized: "\uC544\uBE60\uC5D0 \uB300\uD574\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781896
    m_Localized: "\uB5A0\uB098\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781897
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781898
    m_Localized: "...\uC54C\uACA0\uC2B5\uB2C8\uB2E4.\n\uC54C\uB824\uC8FC\uC154\uC11C
      \uAC10\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781899
    m_Localized: "..\uADF8 \uBAA9\uD328\uB294\n...\uC544\uC800\uC528\uAC00 \uAC00\uC838
      \uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781900
    m_Localized: "...\uC800\uB294 \uC544\uC9C1...\n...\uBC1B\uC744 \uC218 \uC5C6\uC744
      \uAC83 \uAC19\uC544\uC694.."
    m_Metadata:
      m_Items: []
  - m_Id: 9341273103781901
    m_Localized: "\uC544\uBE60.."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458011987968
    m_Localized: "...\uB4E4..\uB9AC\uB294\uAC00..."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458032959488
    m_Localized: "...\uBCF8\uC88C\uC758 \uBAA9\uC18C\uB9AC\uAC00.. \uB4E4\uB9AC\uB294\uAC00..?"
    m_Metadata:
      m_Items: []
  - m_Id: 10914458032959489
    m_Localized: "...\uC624\uC624... \uB4DC\uB514\uC5B4... \n\uBCF8\uC88C\uC758 \uBAA9\uC18C\uB9AC\uB97C
      \uB4E4\uC744 \uC218 \uC788\uB294 \uC790\uAC00 \uB098\uD0C0\uB0AC\uAD6C\uB098..."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458032959490
    m_Localized: "\uB204\uAD6C\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 10914458032959491
    m_Localized: "...\uBCF8\uC88C\uB294 \uAC15\uD638\uB97C \uAC00\uC7A5 \uB192\uC740
      \uACF3\uC5D0\uC11C \uAD7D\uC5B4\uBCF4\uC558\uB358 \uC790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458032959492
    m_Localized: "\uC218\uB9CE\uC740 \uC808\uC138\uACE0\uC218\uAC00 \uB3C4\uC804\uD588\uC73C\uB098
      \uB05D\uB0B4 \uBCF8\uC88C\uB97C \uB118\uC9C0 \uBABB\uD588\uACE0,\n\uCC9C\uD558\uB294
      \uBCF8\uC88C\uB97C \uC815\uC810\uC774\uB77C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458032959493
    m_Localized: "\uADF8\uB7EC\uB098 \uC9C0\uAE08\uC740... \n\uC774 \uB3CC\uC870\uAC01
      \uD558\uB098\uC5D0 \uB0A8\uC740 \uD63C\uBC31\uC5D0 \uBD88\uACFC\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458032959494
    m_Localized: "\uC800\uC5D0\uAC8C \uBB34\uC5C7\uC744 \uC6D0\uD558\uC2DC\uB294\uAC81\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153792
    m_Localized: "\uBCF8\uC88C\uB97C \uBD09\uC778\uD55C \uADF8 \uBE4C\uC5B4\uBA39\uC744
      \uB188\uB4E4\uC740...\n\uBD09\uC778\uB9CC\uC73C\uB85C\uB294 \uB9CC\uC871\uD558\uC9C0
      \uBABB\uD588\uB294\uC9C0,\n\uBD09\uC778\uC11D\uB9C8\uC800 \uC5EC\uB7EC \uC870\uAC01\uC73C\uB85C
      \uCABC\uAC1C \uAC15\uD638 \uACF3\uACF3\uC5D0 \uD769\uC5B4 \uBC84\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153793
    m_Localized: "\uADF8\uB807\uAC8C \uC218\uC2ED \uB144... \uC218\uBC31 \uB144...\n\uC5B4\uCA4C\uBA74
      \uADF8\uBCF4\uB2E4 \uB354 \uAE34 \uC2DC\uAC04\uC774 \uD750\uB974\uACE0.."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153794
    m_Localized: "\uADF8\uB9AC\uACE0 \uB9C8\uCE68\uB0B4...\n\uADF8\uB300\uB97C \uB9CC\uB0AC\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153795
    m_Localized: "\uBCF8\uC88C\uC758 \uBD09\uC778\uC11D\uC744 \uC9C0\uB154\uB358
      \uC790\uB294 \uC140 \uC218 \uC5C6\uC774 \uB9CE\uC558\uB2E4. \uD558\uC9C0\uB9CC...\n\uC624\uC9C1
      \uADF8\uB300\uB9CC\uC774 \uBCF8\uC88C\uC758 \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC744
      \uC218 \uC788\uC5C8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153796
    m_Localized: "\uADF8\uB7EC\uB2C8 \uBCF8\uC88C\uAC00 \uD55C \uAC00\uC9C0 \uC81C\uC548\uC744
      \uD558\uB9C8.\n\uBCF8\uC88C\uC758 \uC81C\uC790\uAC00 \uB418\uC5B4, \uBCF8\uC88C\uC758
      \uBD09\uC778\uC11D\uC744 \uCC3E\uB3C4\uB85D \uD574\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153797
    m_Localized: "\uADF8\uB9AC\uD55C\uB2E4\uBA74...\n\uBCF8\uC88C\uC758 \uBAA8\uB4E0
      \uAC83\uC744 \uC804\uC218\uD574\uC8FC\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153798
    m_Localized: "\uB124, \uC81C\uC790\uAC00 \uB418\uACA0\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153799
    m_Localized: "\uC544\uB2C8\uC694, \uC81C\uC790\uAC00 \uB418\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153800
    m_Localized: "\uBD09\uC778\uC11D\uC744 \uCC3E\uB294 \uC774\uC720\uAC00 \uBB34\uC5C7\uC778\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153801
    m_Localized: "\uC88B\uB2E4! \n\uC774\uC81C \uADF8\uB300\uB294 \uBCF8\uC88C\uC758
      \uC81C\uC790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153802
    m_Localized: "\uAD6C\uBC30\uC9C0\uB840 \uAC19\uC740 \uAC83\uC740 \uB410\uB2E4.\n\uADF8\uB7F0
      \uD5C8\uB840\uD5C8\uC2DD\uC740 \uC0DD\uB7B5\uD558\uB3C4\uB85D \uD558\uC790\uAFB8\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153803
    m_Localized: "\uBCF8\uC88C\uC758 \uBB34\uACF5\uC778  <b>\uB3C4\uD654\uACF5</b>\uC744
      \uC0AC\uC0AC\uD574\uC8FC\uB9C8.\n\uC798 \uBC1B\uC544\uC801\uAC70\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153804
    m_Localized: "\uADFC\uCC98\uC5D0\uC11C \uBCF8\uC88C\uC758 \uD63C\uBC31\uC774
      \uB290\uAEF4\uC9C0\uB294\uAD6C\uB098..\n\uC0B0\uC758 \uC815\uC0C1\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153805
    m_Localized: "\uB098\uC758 \uC81C\uC790\uC57C, \uC0B0\uC758 \uC815\uC0C1\uC73C\uB85C
      \uD5A5\uD558\uAC70\uB77C.\n\uADF8\uACF3\uC5D0 \uB610 \uB2E4\uB978 \uBD09\uC778\uC11D\uC774
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153806
    m_Localized: "\uD558\uD558... \uC81C\uBC95 \uB2F9\uB3CC\uD558\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153807
    m_Localized: "\uADF8\uB807\uB2E4\uBA74 \uB124\uB188\uC774 \uB354 \uC774\uC0C1
      \uC0B4\uC544\uC788\uC744 \uC774\uC720\uB294 \uC5C6\uACA0\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153808
    m_Localized: "\uBCF8\uC88C\uC758 \uCD94\uCE21\uC5D0 \uBD88\uACFC\uD558\uB2E4\uB9CC...\n\uC624\uB79C
      \uC2DC\uAC04\uC774 \uD758\uB7EC \uBD09\uC778\uC774 \uC57D\uD574\uC9C4 \uAC83
      \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153809
    m_Localized: "\uADF8\uB798\uC11C \uC544\uB9C8\uB3C4 \uD769\uC5B4\uC9C4 \uBD09\uC778\uC11D\uC774
      \uB2E4\uC2DC \uD558\uB098\uB85C \uBAA8\uC778\uB2E4\uBA74\n\uBCF8\uC88C\uB3C4
      \uC774 \uC18D\uBC15\uC5D0\uC11C \uBC97\uC5B4\uB0A0 \uC218 \uC788\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10914458037153810
    m_Localized: "\uADF8\uB7EC\uB2C8 \uADF8\uB300\uAC00 \uBCF8\uC88C\uC758 \uC81C\uC790\uAC00
      \uB418\uC5B4 \n\uBD09\uC778\uC11D\uC744 \uCC3E\uC544\uC8FC\uBA74 \uC88B\uACA0\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220800
    m_Localized: "...\uB4E4..\uB9AC\uB294\uAC00..."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220801
    m_Localized: "...\uBCF8\uC88C\uC758 \uBAA9\uC18C\uB9AC\uAC00.. \uB4E4\uB9AC\uB294\uAC00..?"
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220802
    m_Localized: "...\uC624\uC624... \uB4DC\uB514\uC5B4... \n\uBCF8\uC88C\uC758 \uBAA9\uC18C\uB9AC\uB97C
      \uB4E4\uC744 \uC218 \uC788\uB294 \uC790\uAC00 \uB098\uD0C0\uB0AC\uAD6C\uB098..."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220803
    m_Localized: "\uB204\uAD6C\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220804
    m_Localized: "...\uBCF8\uC88C\uB294 \uAC15\uD638\uB97C \uAC00\uC7A5 \uB192\uC740
      \uACF3\uC5D0\uC11C \uAD7D\uC5B4\uBCF4\uC558\uB358 \uC790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220805
    m_Localized: "\uC218\uB9CE\uC740 \uC808\uC138\uACE0\uC218\uAC00 \uB3C4\uC804\uD588\uC73C\uB098
      \uB05D\uB0B4 \uBCF8\uC88C\uB97C \uB118\uC9C0 \uBABB\uD588\uACE0,\n\uCC9C\uD558\uB294
      \uBCF8\uC88C\uB97C \uC815\uC810\uC774\uB77C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220806
    m_Localized: "\uADF8\uB7EC\uB098 \uC9C0\uAE08\uC740... \n\uC774 \uB3CC\uC870\uAC01
      \uD558\uB098\uC5D0 \uB0A8\uC740 \uD63C\uBC31\uC5D0 \uBD88\uACFC\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220807
    m_Localized: "\uC800\uC5D0\uAC8C \uBB34\uC5C7\uC744 \uC6D0\uD558\uC2DC\uB294\uAC81\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220808
    m_Localized: "...\uC2E4\uB85C \uCE58\uC695\uC2A4\uB7FD\uC9C0\uB9CC...\n\uBCF8\uC88C\uB294
      \uBA3C \uC61B\uB0A0 \uBD09\uC778\uB2F9\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220809
    m_Localized: "\uBCF8\uC88C\uB97C \uBD09\uC778\uD55C \uADF8 \uBE4C\uC5B4\uBA39\uC744
      \uB188\uB4E4\uC740...\n\uBD09\uC778\uB9CC\uC73C\uB85C\uB294 \uB9CC\uC871\uD558\uC9C0
      \uBABB\uD588\uB294\uC9C0,\n\uBD09\uC778\uC11D\uB9C8\uC800 \uC5EC\uB7EC \uC870\uAC01\uC73C\uB85C
      \uCABC\uAC1C \uAC15\uD638 \uACF3\uACF3\uC5D0 \uD769\uC5B4 \uBC84\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220810
    m_Localized: "\uADF8\uB807\uAC8C \uC218\uC2ED \uB144... \uC218\uBC31 \uB144...\n\uC5B4\uCA4C\uBA74
      \uADF8\uBCF4\uB2E4 \uB354 \uAE34 \uC2DC\uAC04\uC774 \uD750\uB974\uACE0.."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220811
    m_Localized: "\uADF8\uB9AC\uACE0 \uB9C8\uCE68\uB0B4...\n\uADF8\uB300\uB97C \uB9CC\uB0AC\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220812
    m_Localized: "\uBCF8\uC88C\uC758 \uBD09\uC778\uC11D\uC744 \uC9C0\uB154\uB358
      \uC790\uB294 \uC140 \uC218 \uC5C6\uC774 \uB9CE\uC558\uB2E4. \uD558\uC9C0\uB9CC...\n\uC624\uC9C1
      \uADF8\uB300\uB9CC\uC774 \uBCF8\uC88C\uC758 \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC744
      \uC218 \uC788\uC5C8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220813
    m_Localized: "\uADF8\uB7EC\uB2C8 \uBCF8\uC88C\uAC00 \uD55C \uAC00\uC9C0 \uC81C\uC548\uC744
      \uD558\uB9C8.\n\uBCF8\uC88C\uC758 \uC81C\uC790\uAC00 \uB418\uC5B4, \uBCF8\uC88C\uC758
      \uBD09\uC778\uC11D\uC744 \uCC3E\uB3C4\uB85D \uD574\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220814
    m_Localized: "\uADF8\uB9AC\uD55C\uB2E4\uBA74...\n\uBCF8\uC88C\uC758 \uBAA8\uB4E0
      \uAC83\uC744 \uC804\uC218\uD574\uC8FC\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220815
    m_Localized: "\uB124, \uC81C\uC790\uAC00 \uB418\uACA0\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220816
    m_Localized: "\uC544\uB2C8\uC694, \uC81C\uC790\uAC00 \uB418\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220817
    m_Localized: "\uBD09\uC778\uC11D\uC744 \uCC3E\uB294 \uC774\uC720\uAC00 \uBB34\uC5C7\uC778\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220818
    m_Localized: "\uC88B\uB2E4! \n\uC774\uC81C \uADF8\uB300\uB294 \uBCF8\uC88C\uC758
      \uC81C\uC790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220819
    m_Localized: "\uAD6C\uBC30\uC9C0\uB840 \uAC19\uC740 \uAC83\uC740 \uB410\uB2E4.\n\uADF8\uB7F0
      \uD5C8\uB840\uD5C8\uC2DD\uC740 \uC0DD\uB7B5\uD558\uB3C4\uB85D \uD558\uC790\uAFB8\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220820
    m_Localized: "\uBCF8\uC88C\uC758 \uBB34\uACF5\uC778  <b>\uB3C4\uD654\uACF5</b>\uC744
      \uC0AC\uC0AC\uD574\uC8FC\uB9C8.\n\uC798 \uBC1B\uC544\uC801\uAC70\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220821
    m_Localized: "\uADFC\uCC98\uC5D0\uC11C \uBCF8\uC88C\uC758 \uD63C\uBC31\uC774
      \uB290\uAEF4\uC9C0\uB294\uAD6C\uB098..\n\uC0B0\uC758 \uC815\uC0C1\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220822
    m_Localized: "\uB098\uC758 \uC81C\uC790\uC57C, \uC0B0\uC758 \uC815\uC0C1\uC73C\uB85C
      \uD5A5\uD558\uAC70\uB77C.\n\uADF8\uACF3\uC5D0 \uB610 \uB2E4\uB978 \uBD09\uC778\uC11D\uC774
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220823
    m_Localized: "\uD558\uD558... \uC81C\uBC95 \uB2F9\uB3CC\uD558\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220824
    m_Localized: "\uADF8\uB807\uB2E4\uBA74 \uB124\uB188\uC774 \uB354 \uC774\uC0C1
      \uC0B4\uC544\uC788\uC744 \uC774\uC720\uB294 \uC5C6\uACA0\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220825
    m_Localized: "\uBCF8\uC88C\uC758 \uCD94\uCE21\uC5D0 \uBD88\uACFC\uD558\uB2E4\uB9CC...\n\uC624\uB79C
      \uC2DC\uAC04\uC774 \uD758\uB7EC \uBD09\uC778\uC774 \uC57D\uD574\uC9C4 \uAC83
      \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220826
    m_Localized: "\uADF8\uB798\uC11C \uC544\uB9C8\uB3C4 \uD769\uC5B4\uC9C4 \uBD09\uC778\uC11D\uC774
      \uB2E4\uC2DC \uD558\uB098\uB85C \uBAA8\uC778\uB2E4\uBA74\n\uBCF8\uC88C\uB3C4
      \uC774 \uC18D\uBC15\uC5D0\uC11C \uBC97\uC5B4\uB0A0 \uC218 \uC788\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10916776342220827
    m_Localized: "\uADF8\uB7EC\uB2C8 \uADF8\uB300\uAC00 \uBCF8\uC88C\uC758 \uC81C\uC790\uAC00
      \uB418\uC5B4 \n\uBD09\uC778\uC11D\uC744 \uCC3E\uC544\uC8FC\uBA74 \uC88B\uACA0\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
