%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Teacher_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: b24d2dda7180a914e9db41f0abbdaffb, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 210838777856
    m_Localized: "\uBB34\uC2A8 \uC77C\uC774\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 210972995584
    m_Localized: "\uC218\uB828\uC740 \uC798 \uB418\uACE0 \uC788\uB290\uB0D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 210977189888
    m_Localized: "\uAC00\uB974\uCE68\uC744 \uAD6C\uD558\uB7EC \uC628 \uAC83\uC774\uB0D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 210977189889
    m_Localized: "\uB5A0\uB098\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 210977189890
    m_Localized: "\uBD09\uC778\uC11D\uC774 \uC788\uB294 \uACF3\uC744 \uC5EC\uCB59\uACE0\uC790
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189891
    m_Localized: "\uAC00\uB974\uCE68\uC744 \uCCAD\uD558\uACE0\uC790 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189892
    m_Localized: "\uB3C4\uD654\uACF5\uC758 \uC77C\uBD80\uB9CC \uC54C\uB824\uC8FC\uC2E0
      \uC774\uC720\uAC00 \uAD81\uAE08\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189893
    m_Localized: "..\uCBE7. \uBC8C\uC368 \uC78A\uC5C8\uB290\uB0D0.\n..\uC0B0\uC758
      \uC815\uC0C1\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189894
    m_Localized: "\uC0B0\uC758 \uC815\uC0C1\uC73C\uB85C \uD5A5\uD558\uAC70\uB77C.\n\uADF8\uACF3\uC5D0
      \uBCF8\uC88C\uC758 \uBD09\uC778\uC11D\uC774 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189895
    m_Localized: "\uBB34\uACF5\uC740 \uCD08\uC2DD\uB9CC\uC73C\uB85C \uC774\uB8E8\uC5B4\uC9C0\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189896
    m_Localized: "\uB2E8\uB828\uD55C \uC721\uC2E0, \uC313\uC544 \uC62C\uB9B0 \uB0B4\uACF5,
      \uC218\uB9CE\uC740 \uC2E4\uC804\uACFC \uAE68\uB2EC\uC74C.\n\uADF8 \uC5B4\uB290
      \uD558\uB098\uB77C\uB3C4 \uBD80\uC871\uD558\uBA74 \uC815\uC0C1\uC5D0\uB294
      \uC774\uB97C \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189897
    m_Localized: "\uC218\uB828\uC744 \uAC8C\uC744\uB9AC \uD558\uC9C0\uB9D0\uAC70\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189898
    m_Localized: "\uAC19\uC740 \uCD08\uC2DD\uC744 \uB9CC \uBC88 \uD718\uB458\uB7EC\uB3C4
      \uD5DB\uB41C \uAC83\uC774 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189899
    m_Localized: "\uC5B4\uB290 \uC21C\uAC04 \uADF8 \uD55C \uBC88\uC758 \uAC80\uB05D\uC5D0\uC11C
      \uC0C8\uB85C\uC6B4 \uAE68\uB2EC\uC74C\uC774 \uD53C\uC5B4\uB0A0 \uC218\uB3C4
      \uC788\uC73C\uB2C8.\n\uC801\uC744 \uBCA0\uACE0, \uB610 \uBCA0\uC5B4\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189900
    m_Localized: "\uAC15\uD55C \uC721\uC2E0\uB9CC\uC73C\uB85C\uB294 \uACE0\uC218\uAC00
      \uB420 \uC218 \uC5C6\uACE0,\n\uAE4A\uC740 \uB0B4\uACF5\uB9CC\uC73C\uB85C\uB3C4
      \uCC9C\uD558\uB97C \uB17C\uD560 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189901
    m_Localized: "\uC2EC\xB7\uAE30\xB7\uCCB4\uB97C \uD558\uB098\uB85C \uC544\uC6B0\uB97C
      \uB54C \uBE44\uB85C\uC18C \uC9C4\uC815\uD55C \uBB34\uC778\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189902
    m_Localized: "\uBCF8\uC88C\uC758 \uD63C\uBC31\uC774 \uBD09\uC778\uB418\uC5C8\uB2E4\uB294
      \uC0AC\uC2E4\uC740 \uAE30\uC5B5\uD558\uACE0 \uC788\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 210977189903
    m_Localized: "\uBD09\uC778\uC758 \uC5EC\uD30C\uC77C\uAE4C... \uBCF8\uC88C\uC758
      \uAE30\uC5B5 \uB610\uD55C \uAD70\uB370\uAD70\uB370 \uB04A\uACA8 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210977189904
    m_Localized: "\uADF8\uB798\uC11C \uC9C0\uAE08\uC740 \uC804\uD558\uACE0 \uC2F6\uC5B4\uB3C4
      \uC804\uD560 \uC218 \uC5C6\uB294 \uAC83\uB4E4\uC774 \uB9CE\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210993967104
    m_Localized: "\uD558\uC9C0\uB9CC \uD769\uC5B4\uC9C4 \uBD09\uC778\uC11D\uC744
      \uB418\uCC3E\uC744\uC218\uB85D, \uC783\uC5B4\uBC84\uB9B0 \uAE30\uC5B5 \uB610\uD55C
      \uB418\uB3CC\uC544\uC62C \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210993967105
    m_Localized: "\uADF8\uB54C\uAC00 \uB418\uBA74...\n\uB3C4\uD654\uACF5\uC758 \uB098\uBA38\uC9C0
      \uB610\uD55C \uC804\uC218\uD574 \uC8FC\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 210993967106
    m_Localized: "...\uB4E4..\uB9AC\uB294\uAC00..."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161408
    m_Localized: "...\uBCF8\uC88C\uC758 \uBAA9\uC18C\uB9AC\uAC00.. \uB4E4\uB9AC\uB294\uAC00..?"
    m_Metadata:
      m_Items: []
  - m_Id: 210998161409
    m_Localized: "...\uC624\uC624... \uB4DC\uB514\uC5B4... \n\uBCF8\uC88C\uC758 \uBAA9\uC18C\uB9AC\uB97C
      \uB4E4\uC744 \uC218 \uC788\uB294 \uC790\uAC00 \uB098\uD0C0\uB0AC\uAD6C\uB098..."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161410
    m_Localized: "\uB204\uAD6C\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 210998161411
    m_Localized: "...\uBCF8\uC88C\uAC00 \uB204\uAD6C\uB0D0\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 210998161412
    m_Localized: "...\uBCF8\uC88C\uB294 \uAC15\uD638\uB97C \uAC00\uC7A5 \uB192\uC740
      \uACF3\uC5D0\uC11C \uAD7D\uC5B4\uBCF4\uC558\uB358 \uC790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161413
    m_Localized: "\uC218\uB9CE\uC740 \uC808\uC138\uACE0\uC218\uAC00 \uB3C4\uC804\uD588\uC73C\uB098
      \uB05D\uB0B4 \uBCF8\uC88C\uB97C \uB118\uC9C0 \uBABB\uD588\uACE0,\n\uCC9C\uD558\uB294
      \uBCF8\uC88C\uB97C \uC815\uC810\uC774\uB77C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161414
    m_Localized: "\uADF8\uB7EC\uB098 \uC9C0\uAE08\uC740... \n\uC774 \uB3CC\uC870\uAC01
      \uD558\uB098\uC5D0 \uB0A8\uC740 \uD63C\uBC31\uC5D0 \uBD88\uACFC\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161415
    m_Localized: "\uC800\uC5D0\uAC8C \uBB34\uC5C7\uC744 \uC6D0\uD558\uC2DC\uB294\uAC81\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 210998161416
    m_Localized: "...\uC2E4\uB85C \uCE58\uC695\uC2A4\uB7FD\uC9C0\uB9CC...\n\uBCF8\uC88C\uB294
      \uBA3C \uC61B\uB0A0 \uBD09\uC778\uB2F9\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161417
    m_Localized: "\uBCF8\uC88C\uB97C \uBD09\uC778\uD55C \uADF8 \uBE4C\uC5B4\uBA39\uC744
      \uB188\uB4E4\uC740...\n\uBD09\uC778\uB9CC\uC73C\uB85C\uB294 \uB9CC\uC871\uD558\uC9C0
      \uBABB\uD588\uB294\uC9C0,\n\uBD09\uC778\uC11D\uB9C8\uC800 \uC5EC\uB7EC \uC870\uAC01\uC73C\uB85C
      \uCABC\uAC1C \uAC15\uD638 \uACF3\uACF3\uC5D0 \uD769\uC5B4 \uBC84\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161418
    m_Localized: "\uADF8\uB807\uAC8C \uC218\uC2ED \uB144... \uC218\uBC31 \uB144...\n\uC5B4\uCA4C\uBA74
      \uADF8\uBCF4\uB2E4 \uB354 \uAE34 \uC2DC\uAC04\uC774 \uD750\uB974\uACE0.."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161419
    m_Localized: "\uADF8\uB9AC\uACE0 \uB9C8\uCE68\uB0B4...\n\uADF8\uB300\uB97C \uB9CC\uB0AC\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161420
    m_Localized: "\uBCF8\uC88C\uC758 \uBD09\uC778\uC11D\uC744 \uC9C0\uB154\uB358
      \uC790\uB294 \uC140 \uC218 \uC5C6\uC774 \uB9CE\uC558\uB2E4. \uD558\uC9C0\uB9CC...\n\uC624\uC9C1
      \uADF8\uB300\uB9CC\uC774 \uBCF8\uC88C\uC758 \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC744
      \uC218 \uC788\uC5C8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161421
    m_Localized: "\uADF8\uB7EC\uB2C8 \uBCF8\uC88C\uAC00 \uD55C \uAC00\uC9C0 \uC81C\uC548\uC744
      \uD558\uB9C8.\n\uBCF8\uC88C\uC758 \uC81C\uC790\uAC00 \uB418\uC5B4, \uBCF8\uC88C\uC758
      \uBD09\uC778\uC11D\uC744 \uCC3E\uB3C4\uB85D \uD574\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161422
    m_Localized: "\uADF8\uB9AC\uD55C\uB2E4\uBA74...\n\uBCF8\uC88C\uC758 \uBAA8\uB4E0
      \uAC83\uC744 \uC804\uC218\uD574\uC8FC\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161423
    m_Localized: "\uB124, \uC81C\uC790\uAC00 \uB418\uACA0\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 210998161424
    m_Localized: "\uC544\uB2C8\uC694, \uC81C\uC790\uAC00 \uB418\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161425
    m_Localized: "\uBD09\uC778\uC11D\uC744 \uCC3E\uB294 \uC774\uC720\uAC00 \uBB34\uC5C7\uC778\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 210998161426
    m_Localized: "\uC88B\uB2E4! \n\uC774\uC81C \uADF8\uB300\uB294 \uBCF8\uC88C\uC758
      \uC81C\uC790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161427
    m_Localized: "\uAD6C\uBC30\uC9C0\uB840 \uAC19\uC740 \uAC83\uC740 \uB410\uB2E4.\n\uADF8\uB7F0
      \uD5C8\uB840\uD5C8\uC2DD\uC740 \uC0DD\uB7B5\uD558\uB3C4\uB85D \uD558\uC790\uAFB8\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161428
    m_Localized: "\uBCF8\uC88C\uC758 \uBB34\uACF5\uC778  <b>\uB3C4\uD654\uACF5</b>\uC744
      \uC0AC\uC0AC\uD574\uC8FC\uB9C8.\n\uC798 \uBC1B\uC544\uC801\uAC70\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161429
    m_Localized: "\uADFC\uCC98\uC5D0\uC11C \uBCF8\uC88C\uC758 \uD63C\uBC31\uC774
      \uB290\uAEF4\uC9C0\uB294\uAD6C\uB098..\n...\uC0B0\uC758 \uC815\uC0C1\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161430
    m_Localized: "\uB098\uC758 \uC81C\uC790\uC57C, \uC0B0\uC758 \uC815\uC0C1\uC73C\uB85C
      \uD5A5\uD558\uAC70\uB77C.\n\uADF8\uACF3\uC5D0 \uB610 \uB2E4\uB978 \uBD09\uC778\uC11D\uC774
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161431
    m_Localized: "\uD558\uD558... \uC81C\uBC95 \uB2F9\uB3CC\uD558\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161432
    m_Localized: "\uADF8\uB807\uB2E4\uBA74 \uB124\uB188\uC774 \uB354 \uC774\uC0C1
      \uC0B4\uC544\uC788\uC744 \uC774\uC720\uB294 \uC5C6\uACA0\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161433
    m_Localized: "\uBCF8\uC88C\uC758 \uCD94\uCE21\uC5D0 \uBD88\uACFC\uD558\uB2E4\uB9CC...\n\uC624\uB79C
      \uC2DC\uAC04\uC774 \uD758\uB7EC \uBD09\uC778\uC774 \uC57D\uD574\uC9C4 \uAC83
      \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161434
    m_Localized: "\uADF8\uB798\uC11C \uC544\uB9C8\uB3C4 \uD769\uC5B4\uC9C4 \uBD09\uC778\uC11D\uC774
      \uB2E4\uC2DC \uD558\uB098\uB85C \uBAA8\uC778\uB2E4\uBA74\n\uBCF8\uC88C\uB3C4
      \uC774 \uC18D\uBC15\uC5D0\uC11C \uBC97\uC5B4\uB0A0 \uC218 \uC788\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210998161435
    m_Localized: "\uADF8\uB7EC\uB2C8 \uADF8\uB300\uAC00 \uBCF8\uC88C\uC758 \uC81C\uC790\uAC00
      \uB418\uC5B4 \n\uBD09\uC778\uC11D\uC744 \uCC3E\uC544\uC8FC\uBA74 \uC88B\uACA0\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 15286526308352
    m_Localized: "\uAC15\uD638\uC5D0\uC11C \uACE4\uACBD\uC5D0 \uCC98\uD55C \uC790\uB97C
      \uC678\uBA74\uD558\uC9C0 \uB9C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 15286526308353
    m_Localized: "\uAC80\uC73C\uB85C \uC5BB\uB294 \uAE68\uB2EC\uC74C\uB3C4 \uC788\uC9C0\uB9CC,
      \n\uC0AC\uB78C\uC744 \uAD6C\uD558\uBA70 \uC5BB\uB294 \uAE68\uB2EC\uC74C\uB3C4
      \uC788\uB294 \uBC95\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 380527873388544
    m_Localized: "..\uC73C\uC74C.. \uC9C0\uAE08\uC740 \uC544\uBB34\uAC83\uB3C4 \uB290\uAEF4\uC9C0\uC9C0
      \uC54A\uB294\uAD6C\uB098.\n\uB2F9\uBD84\uAC04\uC740 \uC218\uB828\uC5D0 \uC9D1\uC911\uD558\uAC70\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 10034518861312000
    m_Localized: "...\uC774\uC81C \uAC15\uD558\uAC8C \uB290\uAEF4\uC9C0\uB294\uAD6C\uB098.\n\uC774
      \uBE44\uD0C8\uAE38 \uC704\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
