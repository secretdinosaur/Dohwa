    m_Localized: "\u6211\u304C\u5F1F\u5B50\u3088\u3001\u5C71\u9802\u3078\u5411\u304B\u3048\u3002\n\u305D\u3053\u306B\u3082\u3046\u4E00\u3064\u306E\u5C01\u5370\u77F3\u304C\u3042\u308B\u3002"
