    m_Localized: "\u3086\u3048\u306B\u3001\u6563\u3089\u3070\u3063\u305F\u5C01\u5370\u77F3\u304C\u518D\u3073\u4E00\u3064\u3068\u306A\u308C\u3070\u3001\n\u6211\u3082\u307E\u305F\u3001\u3053\u306E\u675F\u7E1B\u304B\u3089\u89E3\u304D\u653E\u305F\u308C\u308B\u3084\u3082\u3057\u308C\u306C\u3002"
