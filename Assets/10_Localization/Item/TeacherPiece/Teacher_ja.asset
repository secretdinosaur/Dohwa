    m_Localized: "\u306A\u3089\u3070\u3001\u304A\u524D\u304C\u3053\u308C\u4EE5\u4E0A\u751F\u304D\u308B\u7406\u7531\u3082\u3042\u308B\u307E\u3044\u3002"
