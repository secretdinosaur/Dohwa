      m_Items: []
  - m_Id: 210998161435
    m_Localized: "\u3060\u304B\u3089\u3053\u305D\u3001\u304A\u524D\u304C\u6211\u304C\u5F1F\u5B50\u3068\u306A\u308A\u3001\n\u5C01\u5370\u77F3\u3092\u63A2\u3057\u51FA\u3057\u3066\u304F\u308C\u308B\u3068\u52A9\u304B\u308B\u3002"
