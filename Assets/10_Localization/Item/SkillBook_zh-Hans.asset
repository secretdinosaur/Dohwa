    m_Localized: "\u5C06\u6E83\u6563\u4E4B\u6C14\u8840\u4E0E\u5185\u6C14\u5F15\u56DE\u4E39\u7530\uFF0C\u5C06\u8089\u8EAB\u6253\u78E8\u81F3\u6700\u7406\u60F3\u72B6\u6001\u4E4B\u6B63\u7EDF\u5185\u529F\u5FC3\u6CD5\u3002\n\n\u5E76\u975E\u5355\u7EAF\u79EF\u6512\u5185\u529B\uFF0C\u800C\u662F\u8C03\u6B63\u626D\u66F2\u4E4B\u6C14\u8109\u5E76\u9A71\u9010\u6D4A\u6C14\uFF0C\u4F7F\u8FD0\u6C14\u4E4B\u884C\u6B62\u91CD\u5F52\u8FD1\u6E90\u3002\n\n\u5185\u529B\u4E4B\u589E\u957F\u867D\u8F83\u4E3A\u5E73\u7F13\uFF0C\u7136\u968F\u7740\u53CD\u590D\u4FEE\u70BC\uFF0C\u6C14\u8109\u6108\u53D1\u575A\u56FA\uFF0C\u5185\u529B\u4EA6\u6108\u53D1\u7CBE\u7EAF\u3002\n\n\u7ACB\u4E8E\u6B64\u7B49\u6839\u57FA\u4E4B\u4E0A\u6240\u65BD\u5C55\u4E4B\u6B66\u529F\uFF0C\u4EA6\u80FD\u53D1\u6325\u51FA\u66F4\u4E3A\u7A33\u5065\u4E4B\u5A01\u529B\u3002"
