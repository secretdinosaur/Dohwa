  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: SkillBook_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 437d1851397a6a242b0186b1d4ede023, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 36341287166177280
    m_Localized: "\uAC15\uD638\uC0BC\uC7AC\uAC80"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091840
    m_Localized: "\uAC15\uD638\uB97C \uB5A0\uB3CC\uB358 \uD55C \uC774\uB984 \uC5C6\uB294
      \uC0BC\uB958\uAC80\uC218\uAC00 \uC0DD\uACC4\uB97C \uC704\uD574 \uC0BC\uC7AC\uAC80\uC758
      \uCD08\uC2DD\uACFC \uAC80\uB9AC\uB97C \uC5B4\uC124\uD504\uAC8C \uD749\uB0B4
      \uB0B4\uC5B4 \uC5EE\uC740 \uC800\uAE09\uD55C \uAC80\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091841
    m_Localized: "\uD68C\uB958\uC608"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091842
    m_Localized: "\uBB3C\uC758 \uD750\uB984\uC744 \uBCF4\uACE0 \uAE68\uB2EC\uC74C\uC744
      \uC5BB\uC5B4 \uCC3D\uC548\uD55C, \uC0C1\uB300\uC758 \uD798\uC744 \uC815\uBA74\uC73C\uB85C
      \uBC1B\uC544\uB0B4\uAE30\uBCF4\uB2E4 \uD758\uB824\uB0B4\uACE0 \uB418\uB3CC\uB9AC\uB294
      \uB370 \uC911\uC810\uC744 \uB454 \uB2E8\uC77C \uC808\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091843
    m_Localized: "\uC5FD\uC544\uAC80"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091844
    m_Localized: "\uBA39\uC787\uAC10\uC744 \uCAD3\uC544 \uBB34\uC791\uC815 \uB2EC\uB824\uB4DC\uB294
      \uAC83\uC774 \uC544\uB2CC, \uC7A0\uC2DC \uBAB8\uC744 \uBB3C\uB824 \uB54C\uB97C
      \uAE30\uB2E4\uB838\uB2E4\uAC00 \uBE48\uD2C8\uC774 \uB4DC\uB7EC\uB098\uB294
      \uC21C\uAC04 \uC1A1\uACF3\uB2C8\uCC98\uB7FC \uD30C\uACE0\uB4DC\uB294 \uAC80\uBC95"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091845
    m_Localized: "\uD6C4\uD76C\uD68C\uAC80\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091846
    m_Localized: "\uC601\uC545\uD55C \uC6D0\uC22D\uC774\uAC00 \uC0C1\uB300\uB97C
      \uB18D\uB77D\uD558\uB294 \uAE30\uB9CC\uC758 \uAC80\uBC95."
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091847
    m_Localized: "\uC6A9\uB4F1\uD3ED\uD48D\uAC80"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091848
    m_Localized: "\uC6A9\uC774 \uC2B9\uCC9C\uD558\uB4EF \uAC70\uCE68\uC5C6\uC774
      \uAE30\uC138\uB97C \uB04C\uC5B4\uC62C\uB824 \uD3ED\uD48D\uCC98\uB7FC \uAC80\uACA9\uC744
      \uD37C\uBD93\uB294 \uAC15\uACF5\uD615 \uAC80\uBC95"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091849
    m_Localized: "\uB179\uB9BC\uCCB4\uB2E8\uCE60\uC2ED\uC774\uC608"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091850
    m_Localized: "\uB179\uB9BC\uC758 \uC0B0\uCC44\uB4E4 \uC0AC\uC774\uC5D0\uC11C
      \uBE44\uC804\uCC98\uB7FC \uC54C\uC74C\uC54C\uC74C \uC804\uD574 \uB0B4\uB824\uC624\uB294
      \uCE60\uC2ED\uC774 \uAC00\uC9C0\uC758 \uC678\uACF5\uC218\uB828\uBC95\uC744
      \uD55C\uB370 \uC5EE\uC5B4 \uAE30\uB85D\uD55C \uC8FD\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091851
    m_Localized: "\uADC0\uC6D0\uACF5"
    m_Metadata:
      m_Items: []
  - m_Id: 36341287229091852
    m_Localized: "\uD769\uC5B4\uC9C4 \uAE30\uD608\uACFC \uB0B4\uAE30\uB97C \uB2E8\uC804\uC73C\uB85C
      \uB418\uB3CC\uB824, \uBAB8\uC744 \uAC00\uC7A5 \uC774\uC0C1\uC801\uC778 \uC0C1\uD0DC\uB85C
      \uB2E4\uB4EC\uB294 \uC815\uD1B5 \uB0B4\uACF5\uC2EC\uBC95"
    m_Metadata:
      m_Items: []
  - m_Id: 36370287083155456
    m_Localized: "\uAC15\uD638\uB97C \uB5A0\uB3CC\uB358 \uD55C \uC774\uB984 \uC5C6\uB294
      \uC0BC\uB958\uAC80\uC218\uAC00 \n\uC0DD\uACC4\uB97C \uC704\uD574 \uC0BC\uC7AC\uAC80\uC758
      \uCD08\uC2DD\uACFC \uAC80\uB9AC\uB97C \n\uC5B4\uC124\uD504\uAC8C \uD749\uB0B4
      \uB0B4\uC5B4 \uC5EE\uC740 \uC800\uAE09\uD55C \uAC80\uBCF4. \n\n\uC774\uB984\uC740
      \uAC70\uCC3D\uD558\uB098 \uC2E4\uC0C1\uC740 \n\uC815\uD1B5 \uC0BC\uC7AC\uAC80\uC758
      \uAC89\uBAA8\uC2B5\uB9CC \n\uACA8\uC6B0 \uBCF8\uB72C \uC218\uC900\uC5D0 \uBD88\uACFC\uD558\uB2E4.\n\n\uD2B9\uD788
      \uC774\uB984\uC774 \uC815\uD1B5 \uAC80\uBC95\uC778 \n\uC0BC\uC7AC\uAC80\uACFC
      \uC9C0\uB098\uCE58\uAC8C \uBE44\uC2B7\uD55C \uB370\uB2E4, \n\uC55E\uC5D0 \uBD99\uC740
      \u2018\uAC15\uD638\u2019\uB77C\uB294 \uB9D0\uC774 \n\uAD1C\uD55C \uACE0\uC218\uC758
      \uD48D\uCDE8\uB97C \uD48D\uACA8 \n\uBB34\uB9BC\uCD08\uCD9C\uC774\uB098 \uC2DD\uACAC
      \uB0AE\uC740 \uB0AD\uC778\uB4E4\uC774 \n\uC9C4\uBCF8\uACFC \uD63C\uB3D9\uD558\uB294
      \uC77C\uC774 \uC7A6\uB2E4\uACE0 \uC804\uD574\uC9C4\uB2E4.\n\n\uCD08\uC2DD \uC790\uCCB4\uB294
      \uC81C\uBC95 \uADF8\uB7F4\uB4EF\uD558\uC5EC \n\uCD08\uC2EC\uC790\uB4E4\uC744
      \uD604\uD639\uD558\uAE30\uC5D4 \uCDA9\uBD84\uD558\uC9C0\uB9CC, \n\uAC80\uB85C\uC758
      \uC5F0\uACB0\uACFC \uCD08\uC2DD\uC758 \uBB18\uB9AC\uAC00 \uC870\uC545\uD558\uC5EC
      \n\uC870\uAE08\uB9CC \uBCF4\uB294 \uB208\uC774 \uC788\uB294 \uBB34\uC778\uC774\uB77C\uBA74
      \n\uAE08\uC138 \uD55C\uACC4\uB97C \uAC04\uD30C\uD560 \uC218 \uC788\uB2E4.\n\n\uAC12\uC774
      \uC2F8\uACE0 \uC775\uD788\uAE30 \uC27D\uB2E4\uB294 \uC774\uC720\uB85C \n\uC2DC\uC815\uC5D0\uB294
      \uB110\uB9AC \uD37C\uC838 \uC788\uC73C\uB098, \n\uC815\uD1B5 \uBB38\uD30C\uC5D0\uC11C\uB294
      \uAC80\uC758 \uAE30\uCD08\uB97C \uB9DD\uCE58\uB294 \n\uC7A1\uC2A4\uB7EC\uC6B4
      \uAC80\uC220\uC774\uB77C \uD558\uC5EC \uC775\uD788\uB294 \uAC83\uC744 \n\uAD8C\uC7A5\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 36370287112515584
    m_Localized: "\uBB3C\uC758 \uD750\uB984\uC744 \uBCF4\uACE0 \uAE68\uB2EC\uC74C\uC744
      \uC5BB\uC5B4 \uCC3D\uC548\uD55C, \n\uC0C1\uB300\uC758 \uD798\uC744 \uC815\uBA74\uC73C\uB85C
      \uBC1B\uC544\uB0B4\uAE30\uBCF4\uB2E4 \n\uD758\uB824\uB0B4\uACE0 \uB418\uB3CC\uB9AC\uB294
      \uB370 \uC911\uC810\uC744 \uB454 \uB2E8\uC77C \uC808\uAE30. \n\n\uBC00\uB824\uB4DC\uB294
      \uD798\uACFC \uAE30\uC138\uB97C \n\uC5B5\uC9C0\uB85C \uB9C9\uC544\uC11C\uB294
      \uB300\uC2E0 \n\uD750\uB984\uC744 \uB530\uB77C \uBAB8\uC744 \uC6C0\uC9C1\uC774\uACE0,
      \n\uADF8 \uACFC\uC815\uC5D0\uC11C \uC0DD\uAE34 \uBE48\uD2C8\uC744 \uC774\uC6A9\uD574
      \n\uBC18\uACA9\uC73C\uB85C \uC774\uC5B4\uAC00\uB294 \uAE30\uC608\uB2E4.\n\n\uD68C\uB958\uC608\uC758
      \uC6C0\uC9C1\uC784\uC740 \n\uBB3C \uD750\uB974\uB4EF \uC720\uC5F0\uD558\uACE0
      \uC790\uC5F0\uC2A4\uB7FD\uC9C0\uB9CC, \n\uBAB8\uC744 \uBB3C\uB9AC\uACE0, \uD758\uB824\uB0B4\uACE0,
      \uB2E4\uC2DC \uD30C\uACE0\uB4DC\uB294 \n\uC77C\uB828\uC758 \uACFC\uC815\uC774
      \uB04A\uAE30\uC9C0 \uC54A\uACE0 \uC774\uC5B4\uC9C0\uAE30\uC5D0 \n\uC0C1\uB300\uB294
      \uACF5\uACA9\uC774 \uB9C9\uD78C \uAC83\uC778\uC9C0, \n\uC720\uC778\uB2F9\uD55C
      \uAC83\uC778\uC9C0 \uC27D\uAC8C \uBD84\uAC04\uD558\uAE30 \uC5B4\uB835\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 36370287112515585
    m_Localized: "\uBA39\uC787\uAC10\uC744 \uCAD3\uC544 \uBB34\uC791\uC815 \uB2EC\uB824\uB4DC\uB294
      \uAC83\uC774 \uC544\uB2CC\n\uC7A0\uC2DC \uBAB8\uC744 \uBB3C\uB824 \uB54C\uB97C
      \uAE30\uB2E4\uB838\uB2E4\uAC00 \n\uBE48\uD2C8\uC774 \uB4DC\uB7EC\uB098\uB294
      \uC21C\uAC04 \n\uC1A1\uACF3\uB2C8\uCC98\uB7FC \uD30C\uACE0\uB4DC\uB294 \uAC80\uBC95.
      \n\n\uAC80\uC138\uB294 \uC808\uC81C\uB418\uC5B4 \uC788\uC73C\uB098\n\uC77C\uB2E8
      \uAE30\uD68C\uB97C \uD3EC\uCC29\uD55C \uB4A4\uC5D0\uB294 \n\uC9C1\uC120\uC801\uC778
      \uB3CC\uC785\uACFC \uB0A0\uCE74\uB85C\uC6B4 \uC77C\uACA9\uC73C\uB85C \n\uB2E8\uC228\uC5D0
      \uC2B9\uBD80\uB97C \uB0B4\uB824 \uD55C\uB2E4.\n\n\uBD88\uD544\uC694\uD55C \uAC80\uCD08\uB97C
      \uB0A8\uBC1C\uD558\uAE30\uBCF4\uB2E4 \n\uAC70\uB9AC\uC640 \uC2DC\uAE30\uB97C
      \uC7AC\uB294 \uB370 \uC911\uC810\uC744 \uB450\uBA70\n\uC0C1\uB300\uC758 \uACF5\uACA9\uC774
      \uB05D\uB098\uB294 \uC21C\uAC04\uC774\uB098 \n\uC790\uC138\uAC00 \uD750\uD2B8\uB7EC\uC9C0\uB294
      \uCC30\uB098\uB97C \uB178\uB824 \n\uADF8\uB300\uB85C \uAC80\uC744 \uAF42\uC544
      \uB123\uB294 \uB370 \uD2B9\uD654\uB418\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 36370287112515586
    m_Localized: "\uC601\uC545\uD55C \uC6D0\uC22D\uC774\uAC00 \uC0C1\uB300\uB97C
      \uB18D\uB77D\uD558\uB294 \n\uAE30\uB9CC\uC758 \uAC80\uBC95. \n\n\uCC30\uB098\uC758
      \uC21C\uAC04 \uC2E0\uD615\uC744 \uB0A0\uB824 \uACF5\uACA9\uD55C \uB4A4, \n\uC0C1\uB300\uAC00
      \uBC18\uACA9\uD558\uAE30\uB3C4 \uC804\uC5D0 \uC6D0\uC22D\uC774\uCC98\uB7FC
      \uD3F4\uC9DD \uB4A4\uB85C \uBB3C\uB7EC\uB098 \uAC80\uAE30\uB97C \uD758\uB824\uB0B4\uACE0
      \uC801\uC758 \uBD84\uD1B5\uC744 \uD130\uB728\uB9B0\uB2E4.\n\n\uC815\uBA74\uC5D0\uC11C
      \uBB34\uAC81\uAC8C \uAC80\uC744 \uB9DE\uBD80\uB52A\uD788\uAE30\uBCF4\uB2E4\uB294
      \n\uC608\uCE21 \uBD88\uD5C8\uC758 \uB3C4\uC57D\uACFC \uC5F0\uD1F4\uB85C \n\uC804\uD22C\uC758
      \uD750\uB984\uC744 \uB4A4\uD754\uB4DC\uB294 \uB370 \n\uC911\uC810\uC744 \uB454
      \uAC80\uBC95\uC73C\uB85C, \n\n\uC5B8\uB73B \uBCF4\uBA74 \uCD10\uC2F9\uB9DE\uAC8C
      \n\uB3C4\uB9DD\uCE58\uB294 \uB4EF\uD55C \uC6C0\uC9C1\uC784 \uC18D\uC5D0 \n\uC0C1\uB300\uB97C
      \uBC14\uBCF4\uB85C \uB9CC\uB4DC\uB294 \n\uC720\uC778\uC758 \uBB18\uB9AC\uAC00
      \uC228\uC5B4 \uC788\uB2E4.\n\n\uB54C\uBB38\uC5D0 \uBB35\uC9C1\uD55C \uBC95\uB3C4\uB97C
      \uC911\uC2DC\uD558\uB294 \n\uC815\uD30C \uBB34\uC778\uB4E4\uC5D0\uAC8C\uB294
      \uACBD\uB9DD\uC2A4\uB7FD\uACE0 \n\uC57C\uBE44\uD55C \uAC80\uBC95\uC73C\uB85C
      \uBE44\uB09C\uBC1B\uAE30\uB3C4 \uD558\uB098, \n\uC2E4\uC804\uC5D0\uC11C\uB294
      \uC801\uC758 \uD3C9\uC815\uC2EC\uC744 \uC644\uC804\uD788 \uBB34\uB108\uB728\uB824
      \n\uD5C8\uC810\uC744 \uC2A4\uC2A4\uB85C \uB4DC\uB7EC\uB0B4\uAC8C \uB9CC\uB4DC\uB294
      \n\uADF9\uD788 \uC601\uB9AC\uD55C \uC2EC\uB9AC\uC804 \uAC80\uC220\uB85C \uD3C9\uAC00\uB41C\uB2E4.\n\n\uAC80\uC138\uB294
      \uAE43\uD138\uCC98\uB7FC \uAC00\uBCCD\uACE0 \uC584\uBBF8\uC6B0\uBA70, \n\uC6D0\uC22D\uC774\uAC00
      \uB098\uBB34\uC640 \uB098\uBB34 \uC0AC\uC774\uB97C \uB118\uB098\uB4E4\uB4EF
      \n\uB4E4\uC774\uCE58\uACE0 \uBE60\uC9C0\uB294 \uD750\uB984\uC774 \uC6CC\uB099
      \uBCC0\uCE59\uC801\uC774\uB77C \n\uC0C1\uB300\uB294 \uAC80\uC744 \uB0B4\uC9C0\uB974\uACE0\uB3C4
      \n\uD640\uB85C \uB0A8\uACA8\uC9C0\uAC8C \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 36370287112515587
    m_Localized: "\uC6A9\uC774 \uC2B9\uCC9C\uD558\uB4EF \uAC70\uCE68\uC5C6\uC774
      \uAE30\uC138\uB97C \uB04C\uC5B4\uC62C\uB824 \n\uD3ED\uD48D\uCC98\uB7FC \uAC80\uACA9\uC744
      \uD37C\uBD93\uB294 \uAC15\uACF5\uD615 \uAC80\uBC95. \n\n\uAC80\uC138\uB294
      \uAC70\uCE60\uACE0 \uB9F9\uB82C\uD558\uBA70, \n\uD55C \uBC88 \uAE30\uC138\uB97C
      \uD0C4 \uC21C\uAC04\uBD80\uD130 \n\uC5F0\uC774\uC5B4 \uBAB0\uC544\uCE58\uB294
      \uC5F0\uACA9\uC73C\uB85C \n\uC0C1\uB300\uB97C \uC555\uC0B4\uD558\uB294 \uB370
      \uD2B9\uD654\uB418\uC5B4 \uC788\uB2E4.\n\n\uBCF4\uBC95\uACFC \uAC80\uB85C\uB294
      \n\uC9C1\uC120\uC801\uC774\uACE0 \uD638\uCF8C\uD55C \uD3B8\uC5D0 \uC18D\uD558\uB098,
      \n\uADF8\uB9CC\uD07C \uC18D\uB3C4\uC640 \uC555\uBC15\uC774 \uB6F0\uC5B4\uB098
      \n\uC815\uBA74\uC5D0\uC11C \uBC1B\uC544\uB0B4\uAE30 \uC5B4\uB835\uB2E4. \n\n\uAC80\uAD11\uC774
      \uBAB0\uC544\uCE60 \uB54C\uB9C8\uB2E4 \n\uB9C8\uCE58 \uAD11\uD48D \uC18D\uC5D0
      \uD718\uB9D0\uB9B0 \uB4EF\uD55C \n\uCC29\uAC01\uC744 \uBD88\uB7EC\uC77C\uC73C\uD0A4\uBA70,
      \n\uACF5\uACA9\uC774 \uC774\uC5B4\uC9C8\uC218\uB85D \uAC80\uC138\uB294 \uB354\uC6B1
      \uAC70\uC138\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 36370287112515588
    m_Localized: "\uB179\uB9BC\uC758 \uC0B0\uCC44\uB4E4 \uC0AC\uC774\uC5D0\uC11C
      \n\uBE44\uC804\uCC98\uB7FC \uC54C\uC74C\uC54C\uC74C \uC804\uD574 \uB0B4\uB824\uC624\uB294
      \n\uCE60\uC2ED\uC774 \uAC00\uC9C0\uC758 \uC678\uACF5\uC218\uB828\uBC95\uC744
      \uD55C\uB370 \uC5EE\uC5B4 \n\uAE30\uB85D\uD55C \uC8FD\uAC04. \n\n\uAC70\uCE60\uAC8C
      \uAE4E\uC740 \uB098\uBB34\uD310\uC5D0 \uD22C\uBC15\uD55C \uD544\uCCB4\uB85C
      \n\uC0C8\uACA8\uC838 \uC788\uC5B4 \uAC89\uBCF4\uAE30\uC5D0\uB294 \n\uC0B0\uC801\uB4E4\uC758
      \uC7A1\uC2A4\uB7EC\uC6B4 \uB2E8\uB828\uC11C\uCC98\uB7FC \uBCF4\uC774\uC9C0\uB9CC,
      \n\uADF8 \uC548\uC5D0 \uB2F4\uAE34 \uC218\uB828\uBC95 \uD558\uB098\uD558\uB098\uC758
      \uD6A8\uC728\uC740 \n\uC81C\uBC95 \uB6F0\uC5B4\uB098\uB2E4\uACE0 \uC804\uD574\uC9C4\uB2E4.\n\n\uB179\uB9BC
      \uD2B9\uC720\uC758 \uB09C\uD3ED\uD55C \uC2F8\uC6C0\uACFC \n\uD5D8\uC900\uD55C
      \uC0B0\uC911 \uC0DD\uD65C \uC18D\uC5D0\uC11C\n\uC0B4\uC544\uB0A8\uAE30 \uC704\uD574
      \uB9CC\uB4E4\uC5B4\uC9C4 \uB9CC\uD07C, \n\uADFC\uACE8\uC744 \uB2E8\uB828\uD558\uACE0
      \uC721\uC2E0\uC744 \uAC15\uCCA0\uCC98\uB7FC \n\uBCBC\uB824\uB0B4\uB294 \uB370
      \uD2B9\uD654\uB418\uC5B4 \uC788\uC73C\uBA70, \n\uAFB8\uC900\uD788 \uC218\uB828\uD55C
      \uC790\uB294 \uCE7C\uACFC \uBABD\uB465\uC774 \uC815\uB3C4\uB85C\uB294\n\uC27D\uC0AC\uB9AC
      \uC4F0\uB7EC\uC9C0\uC9C0 \uC54A\uB294 \n\uAC15\uAC74\uD55C \uC721\uC2E0\uC744
      \uC5BB\uAC8C \uB41C\uB2E4\uACE0 \uD55C\uB2E4.\n\n\uB05D\uAE4C\uC9C0 \uC218\uB828\uD560
      \uACBD\uC6B0 \n\uAE08\uAC15\uBD88\uAD34\uC5D0 \uC900\uD558\uB294 \uC721\uC2E0\uC5D0
      \n\uC774\uB97C \uC218 \uC788\uB2E4\uB294 \uC18C\uBB38\uB3C4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 36370287112515589
    m_Localized: "\uD769\uC5B4\uC9C4 \uAE30\uD608\uACFC \uB0B4\uAE30\uB97C \uB2E8\uC804\uC73C\uB85C
      \uB418\uB3CC\uB824, \n\uBAB8\uC744 \uAC00\uC7A5 \uC774\uC0C1\uC801\uC778 \uC0C1\uD0DC\uB85C
      \uB2E4\uB4EC\uB294 \n\uC815\uD1B5 \uB0B4\uACF5\uC2EC\uBC95.\n\n\uB2E8\uC21C\uD788
      \uB0B4\uACF5\uC744 \uC313\uB294 \uB370 \uADF8\uCE58\uC9C0 \uC54A\uACE0, \n\uB4A4\uD2C0\uB9B0
      \uAE30\uB9E5\uC744 \uBC14\uB85C\uC7A1\uACE0 \uD0C1\uAE30\uB97C \uBAB0\uC544\uB0B4\uC5B4
      \n\uC6B4\uAE30\uC758 \uD750\uB984\uC744 \uADFC\uC6D0\uC5D0 \uAC00\uAE5D\uAC8C
      \uB418\uB3CC\uB9B0\uB2E4.\n\n\uB0B4\uACF5\uC758 \uC99D\uC9C4\uC740 \uC644\uB9CC\uD558\uC9C0\uB9CC,
      \n\uC218\uB828\uC744 \uAC70\uB4ED\uD560\uC218\uB85D \n\uAE30\uB9E5\uC740 \uB354\uC6B1
      \uACAC\uACE0\uD574\uC9C0\uACE0 \n\uB0B4\uACF5\uC740 \uC815\uC21C\uD574\uC9C4\uB2E4.
      \n\n\uADF8 \uAE30\uBC18 \uC704\uC5D0\uC11C \uD3BC\uCCD0\uC9C0\uB294 \uBB34\uACF5
      \uB610\uD55C\n\uD55C\uCE35 \uC548\uC815\uB41C \uC704\uB825\uC744 \uBC1C\uD718\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 37093555872231424
    m_Localized: "\uB3C4\uD654\uACF5"
    m_Metadata:
      m_Items: []
  - m_Id: 37093555926757376
    m_Localized: "\uC774\uB984\uC870\uCC28 \uC804\uD574\uC9C0\uC9C0 \uC54A\uB294
      \uC5B4\uB290 \uC808\uC138\uACE0\uC218\uAC00\n\uB9CC\uAC1C\uD55C \uB3C4\uD654\uC758
      \uC544\uB984\uB2E4\uC6C0\uACFC \n\uC138\uC6D4\uC774 \uD758\uB7EC\uB3C4 \uC2DC\uB4E4\uC9C0
      \uC54A\uB294 \uC601\uC6D0\uC744 \n\uBB34\uACF5\uC758 \uC774\uCE58\uB85C \uC0BC\uC544
      \uCC3D\uC548\uD55C \uC2E0\uACF5.\n\n\uADF8 \uCC3D\uC2DC\uC790\uB294 \uD589\uC801\uC740
      \uBB3C\uB860 \n\uC5B4\uB5A0\uD55C \uBB38\uD30C\uC5D0 \uC18D\uD574 \uC788\uC5C8\uB294\uC9C0\uC870\uCC28
      \n\uC54C\uB824\uC9C4 \uBC14\uAC00 \uC5C6\uC73C\uBA70\n\uD6C4\uB300\uC5D0 \uADF8
      \uB9E5\uC774 \uC774\uC5B4\uC9C0\uC9C0 \uC54A\uC544 \n\uC624\uB79C \uC138\uC6D4
      \uAC15\uD638\uC758 \uC5ED\uC0AC \uC18D\uC5D0 \uBB3B\uD600 \uC788\uC5C8\uB2E4.\n\n\uB3C4\uD654\uACF5\uC73C\uB85C
      \uC218\uB828\uD55C \uB0B4\uAE30\uB294 \n\uADF9\uB3C4\uB85C \uC815\uC21C\uD558\uBA70\n\uAE30\uB9E5\uC744
      \uB530\uB77C \uB9C9\uD798\uC5C6\uC774 \uC21C\uD658\uD55C\uB2E4. \n\n\uB3C4\uD654\uACF5\uC758
      \uC9C4\uAC00\uB294 \n\uB0B4\uB825\uC758 \uC591\uC774\uB098 \uC704\uB825\uC5D0
      \uC788\uC9C0 \uC54A\uB2E4. \n\n\uB9CC\uAC1C\uD55C \uB3C4\uD654\uAC00 \uC218\uB9CE\uC740
      \uAF43\uB4E4\uACFC \uC5B4\uC6B0\uB7EC\uC9C0\uB4EF\n\uADF8 \uB0B4\uAE30\uB294
      \uC5B4\uB5A0\uD55C \uAE30\uC6B4\uB3C4 \uAC70\uBD80\uD558\uC9C0 \uC54A\uACE0
      \n\uBC1B\uC544\uB4E4\uC5EC \uB05D\uB0B4 \uD558\uB098\uC758 \uD750\uB984\uC73C\uB85C
      \n\uD654\uD569\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 37093555926757377
    m_Localized: "\uC774\uB984\uC870\uCC28 \uC804\uD574\uC9C0\uC9C0 \uC54A\uB294
      \uC5B4\uB290 \uC808\uC138\uACE0\uC218\uAC00, \uB9CC\uAC1C\uD55C \uB3C4\uD654\uC758
      \uC544\uB984\uB2E4\uC6C0\uACFC \uC138\uC6D4\uC774 \uD758\uB7EC\uB3C4 \uC2DC\uB4E4\uC9C0
      \uC54A\uB294 \uC601\uC6D0\uC744 \uBB34\uACF5\uC758 \uC774\uCE58\uB85C \uC0BC\uC544
      \uCC3D\uC548\uD55C \uC2E0\uACF5."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588616105984
    m_Localized: "\uB3C4\uD654 - \uC601"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466112
    m_Localized: "\uB3C4\uD654\uBAA9\uC758 \uBB18\uBAA9\uC744 \uBCF4\uACE0, \n\uC811\uCD09\uD560
      \uC218 \uC788\uAC8C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466113
    m_Localized: "\uB3C4\uD654\uB294 \uBD88\uB85C\uC7A5\uC0DD\uC758 \uC0C1\uC9D5.
      \n\n\uC774 \uC2E0\uACF5\uC744 \uC775\uD78C \uC790\uAC00 \uC4F0\uB7EC\uC9C0\uB354\uB77C\uB3C4
      \n\uADF8 \uC721\uC2E0\uC740 \uC369\uC5B4 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uACE0\n\uC5B4\uB518\uAC00\uC5D0
      \uBFCC\uB9AC\uB0B4\uB9B0 \uB3C4\uD654\uBAA9\uC758 \uBB18\uBAA9\uC5D0\uC11C
      \n\uB2E4\uC2DC \uD0DC\uC5B4\uB09C\uB2E4\uACE0 \uC804\uD574\uC9C4\uB2E4.\n\n\uB610\uD55C
      \uB3C4\uD654\uBAA9\uC758 \uBB18\uBAA9\uC5D0 \uC811\uCD09\uD558\uBA74 \n\uB0A8\uACA8\uC9C4
      \uB0B4\uACF5\uC758 \uAE30\uC6B4\uC5D0 \uC758\uD574 \n\uB610 \uB2E4\uB978 \uB3C4\uD654\uBAA9\uC758
      \uBB18\uBAA9\uC73C\uB85C \n\uC804\uC1A1\uB41C\uB2E4\uACE0 \uD55C\uB2E4. \n\n\uC774\uAC83\uC774
      \uC808\uC138\uACE0\uC218\uAC00 \uD6C4\uD559\uC744 \uC704\uD574 \uB0A8\uAE34
      \n\uC790\uBE44\uC778\uC9C0, \uD639\uC740 \uC8FD\uC74C\uC870\uCC28 \uD5C8\uB77D\uD558\uC9C0
      \uC54A\uB294 \n\uC601\uAC81\uC758 \uAD74\uB808\uC778\uC9C0\uB294 \uB204\uAD6C\uB3C4
      \uC54C\uC9C0 \uBABB\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466114
    m_Localized: "\uB3C4\uD654 - \uC0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466115
    m_Localized: "\uCCB4\uB825\uC774 30% \uC774\uD558\uB85C \uB5A8\uC5B4\uC9C0\uBA74
      \n\uC11C\uC11C\uD788 \uD68C\uBCF5\uD558\uC5EC \n70%\uAE4C\uC9C0 \uC7AC\uC0DD\uB41C\uB2E4.\n\uC774
      \uD798\uC740 \uCD5C\uB300 1\uD68C \uBC1C\uB3D9\uB418\uBA70, \n\uB3C4\uD654\uBAA9\uC5D0\uC11C
      \uD734\uC2DD\uD558\uC5EC \n\uC7AC\uCDA9\uC804 \uD560 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466116
    m_Localized: "\uB3C4\uD654\uACF5\uC744 \uC775\uD78C \uC790\uC758 \uC721\uC2E0\uC5D0\uB294
      \n\uB3C4\uD654\uC758 \uC0DD\uAE30\uAC00 \uAE43\uB4E0\uB2E4\uACE0 \uD55C\uB2E4.
      \n\n\uC0DD\uBA85\uC758 \uBD88\uC528\uAC00 \uC644\uC804\uD788 \uAEBC\uC9C0\uC9C0
      \uC54A\uB294 \uD55C\n\uB2E8\uC804 \uAE4A\uC219\uC774 \uC7A0\uB4E0 \uAE30\uC6B4\uC774
      \uC2A4\uC2A4\uB85C \uAE68\uC5B4\uB098 \n\uB04A\uC5B4\uC9C4 \uD608\uB9E5\uC744
      \uC787\uACE0 \uD769\uC5B4\uC9C4 \uAE30\uD608\uC744 \uB418\uB3CC\uB9B0\uB2E4.\n\n\uD55C
      \uBC88 \uD68C\uBCF5\uC744 \uD588\uB2E4\uBA74 \n\uADF8 \uAE30\uC6B4\uC740 \uBAA8\uB450
      \uC18C\uC9C4\uB418\uBA70\n\uB2E4\uC2DC \uB3C4\uD654\uBAA9\uC744 \uD1B5\uD574
      \n\uC0DD\uBA85\uC758 \uAE30\uC6B4\uC744 \uBC1B\uC544\uB4E4\uC5EC\uC57C\uB9CC
      \n\uADF8 \uD798\uC774 \uCDA9\uB9CC\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466132
    m_Localized: "\uC885\uBCA0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466133
    m_Localized: "\uAC80\uC744 \uC704\uC5D0\uC11C \uC544\uB798\uB85C \uB0B4\uB9AC\uCE5C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466134
    m_Localized: "\uC9C1\uC120\uC801\uC778 \uD798\uACFC \uBB34\uAC8C\uAC00 \uC2E4\uB9AC\uBA70,
      \n\uC0C1\uB300\uC758 \uBC29\uC5B4\uB97C \n\uC815\uBA74\uC73C\uB85C \uAE68\uB728\uB9AC\uB294
      \uB370 \uC4F0\uC778\uB2E4. \n\n\uB2E8\uC21C\uD574 \uBCF4\uC774\uC9C0\uB9CC
      \n\uAC00\uC7A5 \uC2EC\uC624\uD55C \uB3D9\uC791\uC774\uAE30\uB3C4 \uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466135
    m_Localized: "\uD6A1\uBCA0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466136
    m_Localized: "\uAC80\uC744 \uC88C\uC6B0\uB85C \uD718\uB450\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466137
    m_Localized: "\uAC00\uC7A5 \uAE30\uBCF8\uC801\uC778 \uC808\uB2E8 \uADA4\uC801\uC774\uBA70,
      \n\uBC94\uC704\uB97C \uC815\uB9AC\uD558\uACE0 \n\uC801\uC758 \uC811\uADFC\uC744
      \uB04A\uC5B4\uB0B4\uB294 \uB370 \uC4F0\uC778\uB2E4. \n\n\uB2E8\uC21C\uD574
      \uBCF4\uC774\uC9C0\uB9CC \n\uC88C\uC6B0 \uADE0\uD615\uACFC \uAC70\uB9AC \uAC10\uAC01\uC774
      \uD575\uC2EC\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466138
    m_Localized: "\uCC0C\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466139
    m_Localized: "\uAC80\uB05D\uC744 \uACE7\uAC8C \uBED7\uC5B4 \uCC0C\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466140
    m_Localized: "\uCD5C\uC18C\uD55C\uC758 \uC6C0\uC9C1\uC784\uC73C\uB85C\n\uCD5C\uB300\uC758
      \uC9D1\uC911\uC744 \uB9CC\uB4E4\uC5B4\uB0B4\uB294 \uC815\uBC00\uD55C \uACF5\uACA9\uC774\uBA70,
      \n\n\uAC70\uB9AC \uC81C\uC5B4\uC640 \uC21C\uAC04 \uD310\uB2E8\uC774 \uD575\uC2EC\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466149
    m_Localized: "\uD68C\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466150
    m_Localized: "\uC0C1\uB300\uC758 \uACF5\uACA9\uC744 \n\uC815\uBA74\uC73C\uB85C
      \uBC1B\uC544\uB0B4\uC9C0 \uC54A\uACE0 \n\uAC80\uC2E0\uACFC \uAC80\uC138\uB97C
      \uC774\uC6A9\uD574 \n\uBD80\uB4DC\uB7FD\uAC8C \uD758\uB824\uB0B8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466151
    m_Localized: "\uACF5\uACA9\uC5D0 \uC2E4\uB9B0 \uD798\uC744 \n\uBB34\uB9AC\uD558\uAC8C
      \uB9C9\uC544\uB0B4\uB294 \uB300\uC2E0 \n\uD750\uB984\uC744 \uB530\uB77C \uD769\uC5B4\uC9C0\uAC8C
      \uB9CC\uB4E0\uB2E4.\n\n\uADF8 \uACFC\uC815\uC5D0\uC11C \uC18C\uBAA8\uB420 \uCDA9\uACA9\uACFC
      \uAE30\uC6B4\uC758 \uC77C\uBD80\uB97C \n\uAC70\uB450\uC5B4 \uC790\uC2E0\uC758
      \uC9C4\uAE30\uB85C \uD658\uC6D0\uD558\uBA70\n\uB3D9\uC2DC\uC5D0 \uC0C1\uB300\uC758
      \uB0B4\uB825\uC744 \uD06C\uAC8C \uAC10\uC18C\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466152
    m_Localized: "\uD68C\uB958 - \uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466153
    m_Localized: "\uD68C\uB958\uC5D0 \uC131\uACF5\uD558\uBA74 \n\uC77C\uC815 \uC2DC\uAC04
      \uB3D9\uC548 \uACF5\uACA9\uB825\uC774 \n\uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466154
    m_Localized: "\uC0C1\uB300\uC758 \uACF5\uACA9\uC744 \uBC1B\uC544\uB0B4\uB294
      \uC21C\uAC04 \n\uADF8 \uAE30\uC138\uB97C \uC790\uC2E0\uC758 \uC6C0\uC9C1\uC784\uC5D0
      \uB354\uD558\uC5EC\n\uC9E7\uAC8C\uB098\uB9C8 \uADF8 \uD798\uC744 \uC774\uC6A9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466155
    m_Localized: "\uD68C\uB958 - \uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466156
    m_Localized: "\uD68C\uB958\uC758 \uC9C0\uC18D\uC2DC\uAC04\uC774 \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466157
    m_Localized: "\uD68C\uB958\uC758 \uCD08\uC2DD\uC744 \uC870\uAE08 \uB4A4\uD2C0\uC5B4
      \n\uC801\uC758 \uACF5\uACA9\uC744 \uBC1B\uC544\uB0BC \uC218 \uC788\uB294 \n\uC2DC\uAC04\uC774
      \uC99D\uAC00\uD558\uC5EC\n\uBAB8\uC758 \uBD80\uB2F4\uC774 \uB35C\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466162
    m_Localized: "\uD1F4\uC5FD"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466163
    m_Localized: "\uAC80\uC744 \uC591 \uB300\uAC01\uC120\uC73C\uB85C \n\uC5F0\uC774\uC5B4
      \uD718\uB450\uB974\uBA70 \n\uB4A4\uB85C \uB450 \uBCF4 \uBB3C\uB7EC\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466164
    m_Localized: "\uB2E8\uC21C\uD55C \uD6C4\uD1F4\uAC00 \uC544\uB2C8\uB77C \n\uC0C1\uB300\uC758
      \uC2DC\uC120\uC744 \uD754\uB4E4\uACE0 \n\uAC70\uB9AC\uB97C \uC7AC\uAE30 \uC704\uD55C
      \uC6C0\uC9C1\uC784\uC73C\uB85C\n\n\uC0AC\uB0E5\uAFBC\uC774 \uC123\uBD88\uB9AC
      \uB364\uBE44\uC9C0 \uC54A\uACE0 \n\uBA39\uC787\uAC10\uC758 \uC6C0\uC9C1\uC784\uC744
      \uAD00\uCC30\uD558\uBA70 \n\uC0AC\uC815\uAC70\uB9AC\uB97C \uBC8C\uB9AC\uB294
      \uAC83\uACFC \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466165
    m_Localized: "\uC5FD\uC544"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466166
    m_Localized: "\uAC70\uB9AC\uB97C \uC21C\uC2DD\uAC04\uC5D0 \uC881\uD788\uBA70
      \n\uAC80\uC744 \uCC14\uB7EC \uB123\uB294\uB2E4.\n\n\uB0AE\uC740 \uD655\uB960\uB85C
      \uCD9C\uD608\uC744 \uC720\uBC1C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466167
    m_Localized: "\uBA39\uC787\uAC10\uC744 \uBC1C\uACAC\uD55C \uB9F9\uC218\uAC00
      \n\uBAB8\uC744 \uB0AE\uCD94\uACE0 \uB2EC\uB824\uB4E4 \uB4EF\n\n\uD55C\uC21C\uAC04\uC758
      \uAC00\uC18D\uC73C\uB85C \n\uC0C1\uB300\uC758 \uAE09\uC18C\uB97C \uAFF0\uB6AB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466174
    m_Localized: "\uC6D0\uD6C4\uD76C\uAC80"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466175
    m_Localized: "\uC21C\uAC04\uC801\uC73C\uB85C \uC55E\uC73C\uB85C \uD280\uC5B4\uB098\uAC00
      \n\uAC80\uC744 \uD718\uB450\uB978 \uB4A4 \n\uACE7\uBC14\uB85C \uBAB8\uC744
      \uBE7C\uC5B4, \n\uC81C\uC790\uB9AC\uB85C \uB3CC\uC544\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466176
    m_Localized: "\uC6D0\uC22D\uC774\uAC00 \uB098\uBB34\uB97C \uD0C0\uACE0 \uB180\uBA70
      \n\uC0AC\uB78C\uB4E4\uC744 \uD76C\uB871\uD558\uB4EF\n\n\uC885\uC7A1\uC744 \uC218
      \uC5C6\uB294 \uC6C0\uC9C1\uC784\uC744 \uB179\uC5EC\uB0B4\uC5B4 \n\uC77C\uC815\uD55C
      \uAC70\uB9AC\uB97C \uC720\uC9C0\uD558\uBA70 \n\uC815\uC9C1\uD558\uAC8C \uACF5\uBC29\uC744
      \uC8FC\uACE0\uBC1B\uAE30\uBCF4\uB2E8\n\n\uB04A\uC784\uC5C6\uC774 \uC9C4\uD1F4\uB97C
      \uBC18\uBCF5\uD558\uBA70 \n\uC0C1\uB300\uC758 \uC2DC\uC120\uACFC \uD310\uB2E8\uC744
      \n\uD750\uD2B8\uB7EC\uB728\uB9AC\uB294 \uB370 \uC911\uC810\uC744 \uB454\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466177
    m_Localized: "\uD76C\uD76C\uD1F4"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466178
    m_Localized: "\uC7AC\uBE60\uB974\uAC8C \uAC80\uC744 \uD718\uB450\uB974\uACE0
      \n\uB4A4\uB85C \uBB3C\uB7EC\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466179
    m_Localized: "\uC77C\uBD80\uB7EC \uAC70\uB9AC\uB97C \uBC8C\uB9AC\uBA70 \n\uC0C1\uB300\uC758
      \uD310\uB2E8\uC744 \uD750\uD2B8\uB7EC\uB728\uB9AC\uACE0\n\uC774\uC131\uC744
      \uC783\uC740 \uC0C1\uB300\uAC00 \uCAD3\uC544\uC624\uB294 \uB54C\uB97C \n\uB178\uB9B4
      \uC218 \uC788\uAC8C \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466180
    m_Localized: "\uD6C4\uB7C9\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466181
    m_Localized: "\uB300\uC0C1 \uACE0\uC815 \uC0C1\uD0DC\uC77C \uB54C, \n\uD68C\uD53C
      \uAE30\uB2A5\uC758 \uD68C\uBCF5\uC2DC\uAC04\uC774 \n\uBE68\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466182
    m_Localized: "\uC6D0\uC22D\uC774\uC758 \uBBFC\uCCA9\uD55C \uBAB8\uB180\uB9BC\uC5D0\uC11C
      \uC5BB\uC740 \uBB18\uB9AC. \n\n\uC2E0\uD615\uC744 \uB354\uC6B1 \uB0A0\uB835\uD558\uAC8C
      \uC6C0\uC9C1\uC5EC \n\uC801\uC758 \uACF5\uACA9\uC744 \uD53C\uD558\uAC8C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466189
    m_Localized: "\uC9C8\uD48D\uCC38"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466190
    m_Localized: "\uC989\uC2DC \uAC80\uC744 \uAC80\uC9D1\uC5D0 \uC9D1\uC5B4\uB123\uACE0
      \n\uBE60\uB974\uAC8C \uBF51\uC544 \uBCA0\uC5B4\uB0B8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466191
    m_Localized: "\uBC1C\uAC80\uC220\uC758 \uC77C\uC885\uC73C\uB85C \n\uAC80\uC774
      \uAC80\uC9D1\uC5D0\uC11C \uC644\uC804\uD788 \uBE60\uC838\uB098\uC624\uB294
      \uC21C\uAC04, \n\n\uAC80\uACFC \uAC80\uC9D1 \uC0AC\uC774\uC5D0\uC11C \uBC1C\uC0DD\uD558\uB294
      \n\uAE30\uB958\uC758 \uB4A4\uD2C0\uB9BC\uC774 \uCE7C\uBC14\uB78C\uC774 \uB418\uC5B4,
      \n\uD558\uB098\uC758 \uD6C4\uC18D \uC0B4\uCD08\uCC98\uB7FC \uC0B4\uC544 \uC6C0\uC9C1\uC774\uBA70
      \n\uC774\uBBF8 \uD55C \uBC88 \uBCA0\uC5B4\uC9C4 \uACF5\uAC04\uC744 \uB2E4\uC2DC
      \uAC00\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466192
    m_Localized: "\uD3ED\uCC9C\uCC9C\uC1C4"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466193
    m_Localized: "\uAC80\uC744 \uC704\uB85C \uC62C\uB824\uBCA4\uB2E4. \n\uAC80\uB0A0\uC5D0
      \uC751\uCD95\uB418\uC5B4 \uC788\uB358 \uAE30\uC6B4\uC774 \n\uD55C \uBC88\uC5D0
      \uD130\uC838 \uC704\uB85C \uC19F\uAD6C\uCE58\uBA70 \uD3ED\uD48D\uC744 \uC77C\uC73C\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466194
    m_Localized: "\uAC80\uC744 \uC544\uB798\uC5D0\uC11C \uC704\uB85C \uC62C\uB824\uBCA0\uB294
      \uC21C\uAC04, \n\uAC80\uC5D0 \uC751\uCD95\uB41C \uAC80\uAE30\uAC00 \uD3ED\uBC1C\uD558\uBA70
      \n\uD558\uB298\uB85C \uCE58\uC19F\uB294\uB2E4. \n\n\uB4A4\uC774\uC5B4, \uAC80\uC774
      \uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0\uB294 \uCC22\uAE34 \uAE30\uB958\uAC00
      \uB4A4\uD2C0\uB9AC\uBA70 \uD3ED\uD48D\uCC98\uB7FC \uD37C\uC838 \uB098\uAC04\uB2E4.
      \n\n\uC774\uB294 \uC774\uBBF8 \uD558\uB298\uB85C \uC62C\uB77C\uAC00 \uC0AC\uB77C\uC9C4
      \uC774\uBB34\uAE30\uAC00 \uB0A8\uAE34 \uD5C8\uBB3C\uCC98\uB7FC, \n\uC0C1\uC2B9\uC758
      \uB05D\uC5D0 \uB0A8\uC740 \uC794\uC7AC\uC774\uC790 \uD6C4\uD3ED\uD48D\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466195
    m_Localized: "\uC9C8\uD48D\uCC38 - \uAC15"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466196
    m_Localized: "\uC9C8\uD48D\uCC38\uC758 \uD0C0\uACA9\uC774 \n1\uD68C \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466197
    m_Localized: "\uBAB8\uC744 \uADF9\uC801\uC73C\uB85C \uBE44\uD2C0\uC5B4 \n\uCF8C\uC18D\uC73C\uB85C
      \uAC80\uC744 \uBF51\uC544\uB0B8\uB2E4. \n\n\uD55C \uBC88\uC758 \uBC1C\uAC80\uC5D0\uC11C
      \uBE44\uB86F\uB41C \uAC80\uD48D\uC740 \n\uB354 \uB9CE\uC740 \uAC08\uB798\uB97C
      \uC774\uB8E8\uC5B4 \uC0AC\uBC29\uC744 \uB4A4\uB36E\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466198
    m_Localized: "\uD3ED\uCC9C\uCC9C\uC1C4 - \uC2B9"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466199
    m_Localized: "\uB354 \uAC15\uB825\uD55C \uD3ED\uD48D\uC744 \uBD88\uB7EC\uC77C\uC73C\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466200
    m_Localized: "\uD3ED\uD48D\uC740 \uB9C8\uCE68\uB0B4 \uC774\uBB34\uAE30\uC758
      \uACBD\uC9C0\uB97C \uBC97\uC5B4\uB098\n\uC9C4\uB8E1\uC774 \uD758\uB9B0 \uC6A9\uB9B0\uCC98\uB7FC
      \n\uD654\uB824\uD558\uBA74\uC11C\uB3C4 \uC794\uD639\uD55C \uD3ED\uD48D\uC744
      \uC77C\uC73C\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466141
    m_Localized: "\uB9C8\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466142
    m_Localized: "\uC591\uBC1C\uC744 \uC5B4\uAE68\uBCF4\uB2E4 \uB113\uAC8C \uBC8C\uB9AC\uACE0
      \uBB34\uB98E\uC744 \uAD7D\uD600\n\uB9D0\uC744 \uD0C4 \uB4EF\uD55C \uC790\uC138\uB97C
      \uC720\uC9C0\uD55C\uB2E4.\n\n\uCC98\uC74C\uC5D0\uB294 \uBC18 \uAC01\uC5D0\uC11C
      \uC2DC\uC791\uD558\uC5EC \n\uC810\uCC28 \uD55C \uC2DC\uC9C4\uAE4C\uC9C0 \uB298\uB9B0\uB2E4.
      \n\n\uD5C8\uB9AC\uAC00 \uBB34\uB108\uC9C0\uAC70\uB098 \n\uBC1C\uAFC8\uCE58\uAC00
      \uB4E4\uB9AC\uBA74 \n\uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uC120\uB2E4.\n\n\uC2E0\uCCB4\uC758
      \uB2E8\uB828\uC744 \uACBD\uC2DC\uD558\uBA74 \n\uADF8 \uC5B4\uB5A4 \uC77C\uB3C4
      \uD574\uB0BC \uC218 \uC5C6\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466143
    m_Localized: "\uACBD\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466144
    m_Localized: "\uB9E4\uC77C \uC0B0\uAE38\uACFC \uD3C9\uC9C0\uB97C \uC624\uAC00\uBA70
      \n\uC77C\uC815\uD55C \uAC78\uC74C\uC73C\uB85C \uB2EC\uB9B0\uB2E4.\n\n\uC18D\uB3C4\uB97C
      \uACA8\uB8E8\uC9C0 \uB9D0\uACE0 \n\uD638\uD761\uC774 \uD750\uD2B8\uB7EC\uC9C0\uC9C0
      \uC54A\uB294 \uAC78\uC74C\uC744 \uC720\uC9C0\uD55C\uB2E4.\n\n\uAC15\uD638\uC5D0\uC120
      \uBB34\uACF5\uB3C4 \uC911\uC694\uD558\uC9C0\uB9CC \n\uADF8 \uC5B4\uB5A4 \uBB34\uACF5\uC744
      \uD3BC\uCCD0\uB3C4 \n\uC9C0\uCE58\uC9C0 \uC54A\uB294 \uCCB4\uB825 \uB610\uD55C
      \uC911\uC694\uD558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466145
    m_Localized: "\uBA85\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466146
    m_Localized: "\uB4F1\uC744 \uACE7\uAC8C \uD3B4\uACE0 \uAC00\uBD80\uC88C\uB97C
      \uD2C0\uC5B4 \n\uC7A1\uB150\uC744 \uB5A8\uCCD0\uB0B8\uB2E4.\n\n\uB208\uC744
      \uAC10\uACE0 \uCF54\uB85C \uCC9C\uCC9C\uD788 \uC228\uC744 \uB4E4\uC774\uC26C\uACE0,
      \n\uC785\uC73C\uB85C \uAE38\uAC8C \uB0B4\uC270\uB2E4.\n\n\uD638\uD761\uC740
      \uC5B5\uC9C0\uB85C \uAE38\uAC8C \uD558\uC9C0 \uC54A\uACE0  \n\uC790\uC5F0\uC2A4\uB7EC\uC6B4
      \uD750\uB984\uC744 \uC720\uC9C0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466147
    m_Localized: "\uC0BC\uD569\uC218\uB828"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466148
    m_Localized: "\uB9C8\uBCF4, \uACBD\uBCF4, \uBA85\uC0C1\uC758 \n\uC138 \uAC00\uC9C0
      \uAE30\uCD08\uC218\uD589\uC744 \uB9E4\uC77C \uC2DC\uD589\uD558\uBA70 \n\n\uBAB8\uC744
      \uB2E8\uB828\uD558\uACE0, \n\uD638\uD761\uC744 \uB2E4\uC2A4\uB9AC\uBA70, \n\uB9C8\uC74C\uC744
      \uAC00\uB2E4\uB4EC\uB294\uB2E4. \n\n\uC774\uB97C \uD1B5\uD574 \uAC80\uC744
      \uB2E4\uB8E8\uB294 \n\uAE30\uCD08\uC801\uC778 \uBC29\uBC95\uC744 \uAE68\uB2EB\uACE0,
      \n\uD754\uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uAC80\uC758 \uD1A0\uB300\uB97C \uC313\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466158
    m_Localized: "\uC5ED\uB958\uD589"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466159
    m_Localized: "\uC595\uC740 \uACC4\uACE1\uC758 \uBB3C\uC0B4\uC744 \uAC70\uC2AC\uB7EC
      \uAC77\uB294\uB2E4.\n\n\uBE60\uB974\uAC8C \uB098\uC544\uAC00\uB294 \uAC83\uC774
      \uBAA9\uC801\uC774 \uC544\uB2C8\uB77C, \n\uBB3C\uC758 \uD750\uB984\uC744 \uC628\uBAB8\uC73C\uB85C
      \uB290\uB07C\uBA70 \n\uD638\uD761\uACFC \uAC78\uC74C\uC744 \n\uD558\uB098\uB85C
      \uB9DE\uCD94\uB294 \uAC83\uC774 \uC911\uC694\uD558\uB2E4. \n\n\uBC1C\uB05D\uC73C\uB85C
      \uBC84\uD2F0\uC9C0 \uC54A\uACE0 \n\uD750\uB984\uC744 \uC628\uC804\uD788 \uBC1B\uC544\uB4E4\uC774\uBA70
      \n\uD5C8\uB9AC\uC640 \uD558\uCCB4\uB85C \uC911\uC2EC\uC744 \uBC1B\uCE58\uB3C4\uB85D
      \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466160
    m_Localized: "\uAD00\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466161
    m_Localized: "\uD750\uB974\uB294 \uBB3C\uAC00\uC5D0 \uC549\uC544 \n\uBB3C\uC758
      \uD750\uB984\uC744 \uC624\uB79C \uC2DC\uAC04 \uBC14\uB77C\uBCF8\uB2E4.\n\n\uBB3C\uACB0\uC744
      \uC5B5\uC9C0\uB85C \uCAD3\uC9C0 \uB9D0\uACE0, \n\uD758\uB7EC\uAC00\uB294 \uBAA8\uC2B5\uC744
      \uC788\uB294 \uADF8\uB300\uB85C \uBC1B\uC544\uB4E4\uC778\uB2E4.\n\n\uADF8 \uC5B4\uB5A4
      \uC7A5\uC560\uBB3C\uC5D0 \uBD80\uB52A\uD600\uB3C4 \n\uC0C8\uB85C\uC6B4 \uAE38\uC744
      \uB0B4\uC5B4 \n\uB05D\uB0B4 \uC81C \uD750\uB984\uC744 \uC783\uC9C0 \uC54A\uB294
      \n\uADF8 \uC774\uCE58\uB97C \uB9C8\uC74C\uC5D0 \uC0C8\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466168
    m_Localized: "\uBAA9\uACE4\uD0C0\uC2E0"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466169
    m_Localized: "\uB465\uAE00\uAC8C \uB2E4\uB4EC\uC740 \uBAA9\uACE4\uC73C\uB85C
      \n\uC804\uC2E0\uC744 \uB450\uB4DC\uB9AC\uBA70 \uC721\uC2E0\uC744 \uB2E8\uB828\uD55C\uB2E4.\n\n\uC628\uBAB8\uC744
      \uC77C\uC815\uD55C \uAC15\uB3C4\uB85C \uB9E4\uC9C8\uD558\uACE0, \n\uCDA9\uACA9\uC774
      \uB2FF\uB294 \uC21C\uAC04 \uD638\uD761\uC744 \uAC00\uB2E4\uB4EC\uC5B4 \n\uD798\uC744
      \uD55C\uACF3\uC5D0 \uBAA8\uC73C\uB294 \uBC95\uC744 \uC775\uD78C\uB2E4. \n\n\uBAB8\uC744
      \uC0C1\uD558\uAC8C \uD558\uB294 \uAC83\uC774 \uBAA9\uC801\uC774 \uC544\uB2C8\uB77C,
      \n\uBC18\uBCF5\uB418\uB294 \uCDA9\uACA9\uC5D0 \uC775\uC219\uD574\uC838 \uAE30\uC2B5\uC801\uC778
      \uB9F9\uC218\uC758 \uACF5\uACA9\uC5D0\uB3C4 \uC27D\uAC8C \uC4F0\uB7EC\uC9C0\uC9C0
      \uC54A\uB294 \n\uC721\uC2E0\uC744 \uB9CC\uB4DC\uB294 \uAC83\uC774 \uBAA9\uC801\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466170
    m_Localized: "\uC0B0\uD589"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466171
    m_Localized: "\uB9E4\uC77C \uC0B0\uC744 \uC624\uB974\uB0B4\uB9AC\uBA70 \uCCB4\uB825\uC744
      \uB2E8\uB828\uD55C\uB2E4.\n\n\uD3C9\uD0C4\uD55C \uAE38\uBCF4\uB2E4 \n\uD5D8\uD55C
      \uBE44\uD0C8\uACFC \uBC14\uC704\uAE38\uC744 \uD0DD\uD558\uC5EC \uAC77\uACE0,
      \n\uD638\uD761\uC774 \uD750\uD2B8\uB7EC\uC9C0\uC9C0 \uC54A\uB3C4\uB85D \n\uC77C\uC815\uD55C
      \uAC78\uC74C\uC744 \uC720\uC9C0\uD55C\uB2E4. \n\n\uC774\uB97C \uD1B5\uD574
      \uC5B4\uB5A0\uD55C \uC9C0\uD615\uC5D0\uC11C\uB3C4 \n\uC911\uC2EC\uC744 \uC783\uC9C0
      \uC54A\uB294 \uBAB8\uC744 \uB9CC\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466172
    m_Localized: "\uC721\uD0C4\uD6C8\uB828"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466173
    m_Localized: "\uC0AC\uB0E5\uAC10\uACFC \uB4A4\uC5C9\uCF30\uC744 \uB54C\uB97C
      \uAC00\uC815\uD558\uC5EC \n\uB2E8\uC2E0\uC73C\uB85C \uC81C\uC555\uD558\uB294
      \uBC95\uC744 \uC775\uD78C\uB2E4.\n\n\uC8FC\uBA39\uC744 \uACA8\uB8E8\uB294 \uAC83\uC774
      \uC544\uB2C8\uB77C \n\uBAB8\uC758 \uBB34\uAC8C\uB97C \uC2E4\uC5B4 \n\uBC00\uC5B4\uB0B4\uACE0,
      \uBD99\uC7A1\uACE0, \uB118\uC5B4\uB728\uB9AC\uB294 \uB370 \n\uC911\uC810\uC744
      \uB454\uB2E4.\n\n\uC0AC\uB0E5\uAFBC\uC5D0\uAC8C \uC911\uC694\uD55C \uAC83\uC740
      \n\uBA85\uC608\uB85C\uC6B4 \uC2B9\uBD80\uAC00 \uC544\uB2C8\uB77C \n\uB05D\uB0B4
      \uC0B4\uC544\uB0A8\uB294 \uAC83\uC774\uB2E4. \n\n\uD544\uC694\uD558\uB2E4\uBA74
      \n\uD55C \uACF3\uC744 \uB0B4\uC8FC\uC5B4 \n\uD55C \uACF3\uC744 \uCDE8\uD558\uB294\n\uC721\uCC38\uACE8\uB2E8\uC758
      \uAC01\uC624\uB85C \uC0C1\uB300\uB97C \uC81C\uC555\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466183
    m_Localized: "\uC6D0\uD6C4\uB3D9\uAC70"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466184
    m_Localized: "\uC6D0\uC22D\uC774 \uBB34\uB9AC\uC640 \uD568\uAED8 \uC0B0\uC5D0\uC11C
      \uC0DD\uD65C\uD558\uBA70 \n\uADF8\uB4E4\uC758 \uC6C0\uC9C1\uC784\uC744 \uBAB8\uC73C\uB85C
      \uC775\uD78C\uB2E4.\n\n\uBA39\uC774\uB97C \uCC3E\uACE0, \uB098\uBB34\uB97C
      \uC624\uB974\uB0B4\uB9AC\uBA70, \n\uB6F0\uACE0 \uAD6C\uB974\uB294 \uBAA8\uB4E0
      \uD589\uB3D9\uC744 \uD568\uAED8\uD55C\uB2E4. \n\n\uC6D0\uD6C4\uD76C\uAC80\uC758
      \uBAA8\uB4E0 \uC218\uB828\uC740 \n\uC6D0\uC22D\uC774\uC640 \uD568\uAED8 \uC9C0\uB0B4\uB294
      \uAC83\uC5D0\uC11C \uC2DC\uC791\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466185
    m_Localized: "\uC218\uB9BC\uC720\uD76C"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466186
    m_Localized: "\uC6D0\uC22D\uC774\uB4E4\uACFC \uD568\uAED8 \uC232\uC744 \uB6F0\uC5B4\uB2E4\uB2C8\uBA70
      \n\uB098\uBB34\uB97C \uD0C4\uB2E4.\n\n\uC790\uC5F0\uC2A4\uB7FD\uAC8C \uCCB4\uB825\uC774
      \uB298\uC5B4\uB098\uACE0, \n\uBAB8\uC758 \uC720\uC5F0\uC131\uACFC \uADE0\uD615\uAC10\uAC01\uC744
      \uAE30\uB978\uB2E4. \n\n\uB098\uBB47\uAC00\uC9C0\uB97C \uC62E\uACA8 \uD0C0\uB294
      \uACFC\uC815\uC5D0\uC11C \n\uC21C\uAC04\uC801\uC778 \uD310\uB2E8\uB825\uACFC
      \uBBFC\uCCA9\uD55C \uC2E0\uBC95 \uB610\uD55C\n\uD568\uAED8 \uC775\uD788\uAC8C
      \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466187
    m_Localized: "\uC6D0\uBCF4\uCD95\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466188
    m_Localized: "\uC6D0\uC22D\uC774 \uBB34\uB9AC\uC640 \uD568\uAED8 \uC232\uC744
      \uB204\uBE44\uBA70 \n\uC790\uC5F0\uC758 \uAE30\uC6B4\uC744 \uBC1B\uC544\uB4E4\uC778\uB2E4.\n\n\uB098\uBB34\uB97C
      \uC624\uB974\uACE0 \uAC00\uC9C0\uB97C \uC62E\uACA8 \uD0C0\uB294 \uB3D9\uC548
      \n\uD638\uD761\uC744 \uB04A\uC9C0 \uC54A\uACE0 \uC774\uC5B4\uAC00\uBA70, \n\uC232\uC758
      \uB9D1\uC740 \uAE30\uC6B4\uC744 \n\uB2E8\uC804\uC5D0 \uCC28\uACE1\uCC28\uACE1
      \uC313\uB294\uB2E4. \n\n\uC6D0\uC22D\uC774\uCC98\uB7FC \uAC00\uBCCD\uAC8C \uC6C0\uC9C1\uC77C\uC218\uB85D
      \n\uAE30\uC758 \uD750\uB984 \uB610\uD55C \uB9C9\uD798\uC5C6\uC774 \uC774\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466201
    m_Localized: "\uB4F1\uCC9C\uBABD"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466202
    m_Localized: "\uC9C0\uC800\uC758 \uC2EC\uC5F0\uC5D0\uC11C \n\uC218\uBC31 \uB144\uC744
      \uBC84\uD2F4 \uC774\uBB34\uAE30\uAC00 \uC2B9\uCC9C\uC744 \uAFC8\uAFB8\uB4EF\n\n\uBAB8\uC744
      \uB0AE\uCDB0 \uD798\uC744 \uB05D\uC5C6\uC774 \uC751\uCD95\uD558\uACE0\n\uB354\uB294
      \uB2F4\uC544\uB458 \uC218 \uC5C6\uB294 \uC21C\uAC04\n\uC804\uB825\uC744 \uB2E4\uD574
      \uAC80\uC744 \uD718\uB450\uB978\uB2E4. \n\n\uC751\uCD95\uACFC \uD3ED\uBC1C\uC744
      \uBC18\uBCF5\uD560\uC218\uB85D \n\uAC80\uC138\uB294 \uB354\uC6B1 \uAC70\uC138\uC9C0\uACE0\n\uB9C8\uCE68\uB0B4
      \uC6A9\uC774 \uC2B9\uCC9C\uD558\uB294 \uAE30\uC138\uB97C \uC5BB\uAC8C \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466203
    m_Localized: "\uC7A0\uB8E1\uBA74\uBCBD"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466204
    m_Localized: "\uC774\uBB34\uAE30\uAC00 \uC2B9\uCC9C\uC758 \uB54C\uB97C \uAE30\uB2E4\uB9AC\uB4EF
      \n\uAE34 \uC138\uC6D4\uC744 \uC778\uB0B4\uD558\uB294 \uC218\uB828.\n\n\uC881\uC740
      \uB3D9\uAD74\uC5D0\uC11C \uBAB8\uC744 \uB0AE\uCD98 \uCC44 \n\uC624\uB79C \uC2DC\uAC04
      \uAC19\uC740 \uC790\uC138\uB97C \uC720\uC9C0\uD55C\uB2E4. \n\n\uADFC\uC721\uC774
      \uB5A8\uB9AC\uACE0 \uD638\uD761\uC774 \uAC70\uCE60\uC5B4\uC838\uB3C4 \n\uC790\uC138\uB97C
      \uD480\uC9C0 \uC54A\uC73C\uBA70, \n\uC778\uB0B4 \uB05D\uC5D0 \uCC3E\uC544\uC624\uB294
      \n\uD3ED\uBC1C\uC801\uC778 \uD798\uC744 \uAE68\uB2EB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466205
    m_Localized: "\uD608\uC218\uBC8C\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466206
    m_Localized: "\uB2E8\uB2E8\uD55C \uB098\uBB34\uB97C \uC218\uBC31, \uC218\uCC9C
      \uBC88 \n\uC8FC\uBA39\uC73C\uB85C \uB450\uB4E4\uACA8 \uBD80\uC21C\uB2E4.\n\n\uC8FC\uBA39\uC5D0\uC11C
      \uD53C\uAC00 \uD758\uB7EC\uB3C4, \n\uB05D\uAE4C\uC9C0 \uD798\uC744 \uC783\uC9C0
      \uC54A\uACE0 \uB450\uB4E4\uAE30\uB294 \n\uB048\uAE30\uB97C \uC911\uC2DC\uD55C\uB2E4.
      \n\n\uB9C8\uCE68\uB0B4 \uD1B5\uB098\uBB34\uAC00 \uAC08\uB77C\uC9C0\uB294 \uC21C\uAC04,
      \n\uBB34\uC1E0\uAC19\uC740 \uC8FC\uBA39\uC744 \n\uC5BB\uC744 \uC218 \uC788\uAC8C
      \uB41C\uB2E4\uACE0 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466207
    m_Localized: "\uC0AC\uC120\uB4F1\uBC18"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466208
    m_Localized: "\uB9E8\uC190\uC73C\uB85C \uC808\uBCBD\uACFC \uAE09\uACBD\uC0AC\uB97C
      \uC624\uB974\uB0B4\uB9B0\uB2E4.\n\n\uD314\uC5D0 \uD798\uC774 \uB2E4\uD558\uBA74
      \uB2E4\uB9AC\uB85C \uBC84\uD2F0\uACE0, \n\uB2E4\uB9AC\uB9C8\uC800 \uD480\uB9AC\uBA74
      \uC628\uBAB8\uC744 \uBC14\uC704\uC5D0 \uBC00\uCC29\uC2DC\uCF1C \n\uAE30\uC5B4\uC624\uB978\uB2E4.\n\n\uB5A8\uC5B4\uC838\uB3C4
      \uBAA9\uC228\uB9CC \uBD99\uC5B4 \uC788\uB2E4\uBA74 \n\uCC98\uC74C\uBD80\uD130
      \uB2E4\uC2DC \uC2DC\uC791\uD558\uBA70, \n\uB05D\uC5C6\uB294 \uBC18\uBCF5\uC73C\uB85C
      \uC9C0\uAD6C\uB825\uACFC \uC545\uB825\uC744 \n\uD568\uAED8 \uB2E8\uB828\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466209
    m_Localized: "\uCDA9\uC554\uB2E8\uB828"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466210
    m_Localized: "\uAC70\uB300\uD55C \uBC14\uC704\uB97C \uD5A5\uD574 \n\uC628\uBAB8\uC744
      \uBD80\uB52A\uCE58\uBA70 \uC721\uC2E0\uC744 \uB2E8\uB828\uD55C\uB2E4.\n\n\uCC98\uC74C\uC5D0\uB294
      \uAC00\uBCCD\uAC8C \uBAB8\uC744 \uBD80\uB52A\uCE58\uC9C0\uB9CC, \n\uC810\uCC28
      \uD798\uC744 \uB354\uD574 \uBC14\uC704\uAC00 \uBD80\uC11C\uC9C8 \uC815\uB3C4\uC758
      \n\uCDA9\uACA9\uC744 \uACAC\uB38C\uB0B8\uB2E4. \n\n\uC0B4\uC774 \uD130\uC9C0\uACE0
      \uBA4D\uC774 \uB4DC\uB294 \uAC83\uC740 \uC608\uC0BF\uC77C\uC774\uBA70, \n\uADF8
      \uC5B4\uB5A4 \uCDA9\uACA9\uC5D0\uB3C4 \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uB294
      \n\uAC15\uAC74\uD55C \uC721\uC2E0\uC744 \uB9CC\uB4DC\uB294 \uAC83\uC774 \uBAA9\uC801\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466211
    m_Localized: "\uB09C\uD0C0\uB300\uB828"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466212
    m_Localized: "\uB179\uB9BC\uCCB4\uB2E8\uCE60\uC2ED\uC774\uC608\uB97C \uC775\uD78C
      \uC790\uB4E4\uB07C\uB9AC \n\uD558\uB8E8 \uC885\uC77C \uC11C\uB85C\uB97C \uB450\uB4E4\uACA8
      \uD328\uBA70 \n\uC721\uC2E0\uC744 \uB2E8\uB828\uD55C\uB2E4.\n\n\uCD08\uC2DD\uB3C4,
      \uADDC\uCE59\uB3C4 \uC5C6\uC73C\uBA70, \n\uC4F0\uB7EC\uC9C8 \uB54C\uAE4C\uC9C0
      \uC5BB\uC5B4\uB9DE\uACE0, \n\uB2E4\uC2DC \uC77C\uC5B4\uB098 \uC8FC\uBA39\uC744
      \uD718\uB450\uB978\uB2E4. \n\n\uBA4D\uACFC \uC0C1\uCC98\uB294 \uD6C8\uC7A5\uC73C\uB85C
      \uC5EC\uAE30\uBA70, \n\uD53C\uAC00 \uB9C8\uB974\uAE30 \uC804\uC5D0 \uC218\uB828\uC744
      \uB05D\uB0B4\uB294 \uAC83\uC744 \n\uC218\uCE58\uB85C \uC548\uB2E4. \n\n\uB05D\uC5C6\uB294
      \uB09C\uD0C0 \uC18D\uC5D0\uC11C \n\uC721\uC2E0\uC740 \uCDA9\uACA9\uC5D0 \uC775\uC219\uD574\uC9C0\uACE0,
      \n\uC815\uC2E0\uC740 \uACE0\uD1B5\uC5D0 \uAD74\uBCF5\uD558\uC9C0 \uC54A\uAC8C
      \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466213
    m_Localized: "\uADC0\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466214
    m_Localized: "\uBAA8\uB4E0 \uC6B4\uAE30\uB97C \uBA48\uCD94\uACE0, \uD769\uC5B4\uC9C4
      \uAE30\uB97C \uB2E8\uC804\uC73C\uB85C \uB418\uB3CC\uB9AC\uB294 \uBC95\uC744
      \uC775\uD78C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466215
    m_Localized: "\uADC0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466216
    m_Localized: "\uD638\uD761\uC744 \uAC00\uB2E4\uB4EC\uACE0 \n\uBAB8 \uACF3\uACF3\uC5D0
      \uD769\uC5B4\uC9C4 \uAE30\uB97C \uAC10\uC9C0\uD55C\uB2E4. \n\n\uAE30\uB294
      \uAC15\uC81C\uB85C \uB2E4\uC2A4\uB9AC\uB294 \uAC83\uC774 \uC544\uB2C8\uB77C
      \n\uC2A4\uC2A4\uB85C \uD758\uB7EC\uB4E4\uAC8C \uD558\uB294 \uAC83\uC774\uB2E4.\n\n\uAC10\uC9C0\uD55C
      \uB0B4\uBD80\uC758 \uAE30\uB97C \uC5B5\uC9C0\uB85C \uB04C\uC5B4\uB4E4\uC774\uC9C0
      \uC54A\uACE0 \n\uC790\uC5F0\uC2A4\uB7FD\uAC8C \uB2E8\uC804\uC73C\uB85C \uB3CC\uC544\uC624\uB3C4\uB85D
      \uC774\uB048\uB2E4. \n\n\uC870\uAE09\uD574\uD55C\uB2E4\uBA74\n\uAE30\uC758
      \uD750\uB984\uC744 \uC5B4\uC9C0\uB7FD\uD788\uACE0 \uB0B4\uC0C1\uC744 \uB0A8\uAE30\uBA70,
      \n\uC2EC\uD55C \uACBD\uC6B0 \uC8FC\uD654\uC785\uB9C8\uC5D0 \uC774\uB97C \uC218\uB3C4
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466217
    m_Localized: "\uADC0\uB9E5"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466218
    m_Localized: "\uB2E8\uC804\uC5D0 \uBAA8\uC778 \uB0B4\uAE30\uB97C \n\uC2ED\uC774\uC815\uACBD\uACFC
      \uAE30\uACBD\uD314\uB9E5\uC744 \uB530\uB77C \n\uCC9C\uCC9C\uD788 \uC21C\uD658\uC2DC\uD0A8\uB2E4.\n\n\uB9C9\uD78C
      \uAE30\uB9E5\uC740 \uB6AB\uACE0, \n\uB4A4\uD2C0\uB9B0 \uD608\uB9E5\uC740 \uBC14\uB85C\uC7A1\uC73C\uBA70
      \n\uBAB8 \uC804\uCCB4\uC758 \uD750\uB984\uC744 \uACE0\uB974\uAC8C \uB2E4\uB4EC\uB294\uB2E4.\n\n\uAE30\uC758
      \uD750\uB984\uC744 \uC5B5\uC9C0\uB85C \uC7AC\uCD09\uD558\uAC70\uB098 \n\uC21C\uC11C\uB97C
      \uC5B4\uAE30\uBA74 \uAE30\uB9E5\uC5D0 \uBB34\uB9AC\uAC00 \uAC04\uB2E4.\n\n\uC2EC\uD558\uBA74
      \uAE30\uD608\uC774 \uC5C9\uCF1C \n\uADF9\uC2EC\uD55C \uD1B5\uC99D\uC744 \uACAA\uAC8C
      \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466219
    m_Localized: "\uC815\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466220
    m_Localized: "\uD68C\uC218\uD55C \uAE30\uB97C \uC815\uB828\uD558\uC5EC \uBD88\uC21C\uBB3C\uC744
      \uAC77\uC5B4\uB0B8\uB2E4.\n\n\uB0B4\uAE30\uB294 \uC810\uCC28 \uCC9C\uC9C0\uC758
      \uAE30\uC6B4\uACFC \uB2E4\uB97C \uBC14 \uC5C6\uB294 \n\uC790\uC5F0\uC2A4\uB7EC\uC6B4
      \uC0C1\uD0DC\uB85C \uBCC0\uD654\uD558\uAC8C \uB41C\uB2E4.\n\n\uC815\uC21C\uD574\uC9C4
      \uB0B4\uAE30\uB294 \n\uBAB8\uC758 \uAC70\uBD80\uAC10 \uC5C6\uC774 \uD750\uB974\uAE30\uC5D0
      \n\uC5B4\uB5A4 \uBB34\uACF5\uACFC \uC2EC\uBC95\uC744 \uD3BC\uCE58\uB354\uB77C\uB3C4
      \n\uB354\uC6B1 \uBD80\uB4DC\uB7FD\uACE0 \uC815\uAD50\uD558\uAC8C \uC6B4\uC6A9\uD560
      \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466221
    m_Localized: "\uC815\uB9E5"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466222
    m_Localized: "\uAE30\uB9E5\uACFC \uD608\uB9E5\uC744 \uBC18\uBCF5\uD558\uC5EC
      \uB2E8\uB828\uD568\uC73C\uB85C\uC368 \n\uBAB8 \uC790\uCCB4\uB97C \uD558\uB098\uC758
      \uADF8\uB987\uC73C\uB85C \uC644\uC131\uD55C\uB2E4. \n\n\uCDA9\uACA9\uC744 \uD758\uB824\uBCF4\uB0B4\uB294
      \uD798\uC774 \uC0DD\uACA8 \n\uB0B4\uC0C1\uC5D0 \uAC15\uD574\uC9C8 \uBFD0 \uC544\uB2C8\uB77C,
      \n\uC678\uC0C1 \uB610\uD55C \uC27D\uAC8C \uC785\uC9C0 \uC54A\uB294 \n\uAC15\uC778\uD55C
      \uC721\uC2E0\uC744 \uC5BB\uAC8C \uB41C\uB2E4.\n\n\uB2E8\uB828\uB41C \uAE30\uB9E5\uC740
      \n\uACA9\uB82C\uD55C \uC6B4\uAE30\uC5D0\uB3C4 \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uC73C\uBA70,
      \n\uC5B4\uB5A0\uD55C \uAE30\uC6B4\uB3C4 \uC548\uC815\uC801\uC73C\uB85C \n\uBC1B\uC544\uB4E4\uC77C
      \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466223
    m_Localized: "\uBC18\uBCF8\uADC0\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 47229588645466224
    m_Localized: "\uADC0\uC6D0\uACF5\uC758 \uADF9\uC758.\n\n\uBAB8\uC5D0 \uB0A8\uC740
      \uBD88\uC21C\uD55C \uAE30\uAC00 \uBAA8\uB450 \uC0AC\uB77C\uC9C0\uACE0, \n\uC6B4\uAE30
      \uC790\uCCB4\uAC00 \uBCF8\uB2A5\uC774 \uB41C\uB2E4. \n\n\uC5B5\uC9C0\uB85C
      \uB0B4\uAE30\uB97C \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC544\uB3C4 \n\uAE30\uB294
      \uC2A4\uC2A4\uB85C \uAC00\uC7A5 \uC774\uC0C1\uC801\uC778 \uACBD\uB85C\uB97C
      \uCC3E\uC544 \n\uC21C\uD658\uD55C\uB2E4. \n\n\uC774\uD6C4 \uC775\uD788\uB294
      \uC5B4\uB5A4 \uB0B4\uACF5\uC2EC\uBC95\uACFC \uBB34\uACF5\uB3C4 \n\uB354\uC6B1
      \uB192\uC740 \uC644\uC131\uB3C4\uB97C \uC774\uB04C\uC5B4 \uB0BC \uC218 \uC788\uC73C\uBA70,
      \n\uB2E4\uB978 \uC2EC\uBC95\uACFC \uCDA9\uB3CC\uD560 \uAC00\uB2A5\uC131 \uB610\uD55C
      \n\uD06C\uAC8C \uC904\uC5B4\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48927105154142208
    m_Localized: ' '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
