      m_Items: []
  - m_Id: 37506555095576577
    m_Localized: "\uC9D0\uC2B9\uC758 \uACE0\uAE30\uB97C \uB9D0\uB824 \uB9CC\uB4E0
      \uBCF4\uC874\uC2DD. \uC624\uB798 \uB450\uACE0 \uBA39\uC744 \uC218 \uC788\uC5B4
