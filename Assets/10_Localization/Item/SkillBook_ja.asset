    m_Localized: "\u5E30\u5143\u529F\u306E\u6975\u610F\u3002\n\n\u8EAB\u4F53\u306B\u6B8B\u3063\u305F\u4E0D\u7D14\u306A\u6C17\u304C\u5B8C\u5168\u306B\u6D88\u3048\u53BB\u308A\u3001\u904B\u6C17\u305D\u306E\u3082\u306E\u304C\u672C\u80FD\u3068\u306A\u308B\u3002\n\n\u7121\u7406\u306B\u5185\u6C17\u3092\u52D5\u304B\u3055\u305A\u3068\u3082\u3001\u6C17\u306F\u81EA\u3089\u6700\u3082\u7406\u60F3\u7684\u306A\u7D4C\u8DEF\u3092\u63A2\u3057\u3066\u5FAA\u74B0\u3059\u308B\u3002\n\n\u4EE5\u964D\u4FEE\u5F97\u3059\u308B\u3044\u304B\u306A\u308B\u5185\u529F\u5FC3\u6CD5\u3084\u6B66\u529F\u3082\u3001\u3088\u308A\u9AD8\u3044\u5B8C\u6210\u5EA6\u3092\u5F15\u304D\u51FA\u3059\u3053\u3068\u304C\u3067\u304D\u3001\u4ED6\u306E\u5FC3\u6CD5\u3068\u885D\u7A81\u3059\u308B\u53EF\u80FD\u6027\u3082\u5927\u5E45\u306B\u6E1B\u5C11\u3059\u308B\u3002"
