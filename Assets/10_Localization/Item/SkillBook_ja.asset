    m_Localized: "\u4E39\u7530\u306B\u96C6\u307E\u3063\u305F\u5185\u6C17\u3092\u5341\u4E8C\u6B63\u7D4C\u3068\u5947\u7D4C\u516B\u8108\u306B\u6CBF\u3063\u3066\u3086\u3063\u304F\u308A\u3068\u5FAA\u74B0\u3055\u305B\u308B\u3002\n\n\u6EDE\u3063\u305F\u6C17\u8108\u3092\u901A\u3057\u3001\u6B6A\u3093\u3060\u8840\u8108\u3092\u6B63\u3057\u3066\u4F53\u5168\u4F53\u306E\u6D41\u308C\u3092\u5747\u4E00\u306B\u6574\u3048\u308B\u3002\n\n\u6C17\u306E\u6D41\u308C\u3092\u7121\u7406\u306B\u6025\u304B\u3057\u305F\u308A\u9806\u5E8F\u3092\u7834\u3063\u305F\u308A\u3059\u308B\u3068\u6C17\u8108\u306B\u8CA0\u62C5\u304C\u304B\u304B\u308A\u3001\u9177\u3044\u5834\u5408\u306F\u6C17\u8840\u304C\u7D61\u307F\u5408\u3063\u3066\u6FC0\u3057\u3044\u75DB\u307F\u3092\u4F34\u3046\u3053\u3068\u306B\u306A\u308B\u3002"
