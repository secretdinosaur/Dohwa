    m_Localized: "\u7DD1\u6797\u306E\u7826\u306E\u9593\u3067\u79D8\u4F1D\u306E\u3054\u3068\u304F\u5BC6\u304B\u306B\u4F1D\u3048\u3089\u308C\u3066\u304D\u305F\u3001\u4E03\u5341\u4E8C\u7A2E\u306E\u5916\u529F\u4FEE\u884C\u6CD5\u3092\u4E00\u3064\u306B\u307E\u3068\u3081\u3066\u8A18\u9332\u3057\u305F\u7AF9\u7C21\u3002\n\n\u8352\u304F\u524A\u3089\u308C\u305F\u6728\u677F\u306B\u6CE5\u81ED\u3044\u7B46\u81F4\u3067\u523B\u307E\u308C\u3066\u304A\u308A\u3001\u4E00\u898B\u3059\u308B\u3068\u5C71\u8CCA\u305F\u3061\u306E\u96D1\u591A\u306A\u935B\u932C\u66F8\u306E\u3088\u3046\u306B\u898B\u3048\u308B\u304C\u3001\u305D\u3053\u306B\u8FBC\u3081\u3089\u308C\u305F\u4FEE\u884C\u6CD5\u4E00\u3064\u3072\u3068\u3064\u306E\u52B9\u7387\u306F\u304B\u306A\u308A\u512A\u308C\u3066\u3044\u308B\u3068\u4F1D\u3048\u3089\u308C\u3066\u3044\u308B\u3002\n\n\u7DD1\u6797\u7279\u6709\u306E\u8352\u3005\u3057\u3044\u6226\u3044\u3068\u967A\u3057\u3044\u5C71\u4E2D\u751F\u6D3B\u306E\u4E2D\u3067\u751F\u304D\u6B8B\u308B\u305F\u3081\u306B\u4F5C\u3089\u308C\u305F\u3060\u3051\u306B\u3001\u7B4B\u9AA8\u3092\u935B\u3048\u4E0A\u3052\u3001\u8089\u4F53\u3092\u92FC\u306E\u3088\u3046\u306B\u935B\u3048\u629C\u304F\u3053\u3068\u306B\u7279\u5316\u3057\u3066\u304A\u308A\u3001\u3053\u3064\u3053\u3064\u3068\u4FEE\u7DF4\u3092\u91CD\u306D\u305F\u8005\u306F\u5200\u3084\u68CD\u68D2\u7A0B\u5EA6\u3067\u306F\u5BB9\u6613\u306B\u5012\u308C\u306A\u3044\u5F37\u5065\u306A\u8089\u4F53\u3092\u624B\u306B\u5165\u308C\u308B\u3068\u3044\u3046\u3002\n\n\u6975\u9650\u307E\u3067\u4FEE\u7DF4\u3092\u7A4D\u3093\u3060\u5834\u5408\u3001\u91D1\u525B\u4E0D\u58CA\u306B\u3082\u5339\u6575\u3059\u308B\u8089\u4F53\u306B\u9054\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3068\u3044\u3046\u5642\u3082\u3042\u308B\u3002"
