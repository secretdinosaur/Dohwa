    m_Localized: "\u6C17\u8108\u3068\u8840\u8108\u3092\u53CD\u5FA9\u3057\u3066\u935B\u932C\u3059\u308B\u3053\u3068\u3067\u3001\u8EAB\u4F53\u305D\u306E\u3082\u306E\u3092\u4E00\u3064\u306E\u5668\u3068\u3057\u3066\u5B8C\u6210\u3055\u305B\u308B\u3002\n\n\u885D\u6483\u3092\u53D7\u3051\u6D41\u3059\u529B\u304C\u751F\u307E\u308C\u3001\u5185\u50B7\u306B\u5F37\u304F\u306A\u308B\u3060\u3051\u3067\u306A\u304F\u3001\u5916\u50B7\u3082\u5BB9\u6613\u306B\u306F\u8CA0\u308F\u306A\u3044\u5F37\u976D\u306A\u8089\u4F53\u3092\u624B\u306B\u5165\u308C\u308B\u3002\n\n\u935B\u3048\u4E0A\u3052\u3089\u308C\u305F\u6C17\u8108\u306F\u6FC0\u3057\u3044\u904B\u6C17\u306B\u3082\u63FA\u308B\u304C\u305A\u3001\u3044\u304B\u306A\u308B\u6C17\u3082\u5B89\u5B9A\u3057\u3066\u53D7\u3051\u5165\u308C\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3002"
