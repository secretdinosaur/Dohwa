  m_TableData:
  - m_Id: 39070850166059008
    m_Localized: Iron Sword
    m_Metadata:
      m_Items: []
  - m_Id: 39070850304471040
    m_Localized: "A common sword forged from low-grade iron. \nIt dulls quickly and
      lacks a keen edge."
    m_Metadata:
      m_Items: []
  - m_Id: 39070850304471041
    m_Localized: ATK +10
    m_Metadata:
      m_Items: []
  - m_Id: 39070850304471042
    m_Localized: Steel Sword
    m_Metadata:
      m_Items: []
  - m_Id: 39070850308665344
    m_Localized: "A sword forged from refined, high-quality steel. \nSharp and durable,
      it commands a high price."
    m_Metadata:
      m_Items: []
  - m_Id: 39070850308665345
    m_Localized: ATK +20
    m_Metadata:
      m_Items: []
  - m_Id: 39070850308665346
    m_Localized: Azurewood Sword
    m_Metadata:
      m_Items: []
  - m_Id: 39070850308665347
    m_Localized: "The cherished sword of Cheolgeomhho of the Second Hall of Greenwood.
      \nDespite its elegant name, every one of its previous masters met a violent
      end. \nAmong the jianghu, it is whispered to be an ill-omened demon sword."
    m_Metadata:
      m_Items: []
  - m_Id: 39070850308665348
    m_Localized: ATK +30
    m_Metadata:
      m_Items: []
  - m_Id: 39070850308665349
    m_Localized: Golden Crest Sword
    m_Metadata:
      m_Items: []
  - m_Id: 39070850308665350
    m_Localized: "A ceremonial sword belonging to a prestigious martial clan. \nWhen
      drawn, its blade emits a faint, silvery sword aura."
    m_Metadata:
      m_Items: []
  - m_Id: 39070850308665351
    m_Localized: ATK +45
    m_Metadata:
      m_Items: []
