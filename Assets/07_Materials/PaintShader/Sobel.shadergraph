        },
        {
            "m_Id": "5df5da3d337c4273b4bc250658dfe6b2"
        },
        {
            "m_Id": "f3c885be90d94507adb89e5fde8353ac"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Sobel",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 distortedUV = UV; \r\nfloat depthEdge = 0;\r\nfloat normalEdge = 0; \r\n\r\nfloat2 offsets[9] = {\r\n    float2(-1, 1), float2(0, 1), float2(1, 1),\r\n    float2(-1, 0), float2(0, 0), float2(1, 0),\r\n    float2(-1, -1), float2(0, -1), float2(1, -1)\r\n};\r\n\r\nfloat centerRaw = SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV);\r\nfloat centerDepth = LinearEyeDepth(centerRaw, _ZBufferParams);\r\n\r\nfloat4 clipPos = float4(UV * 2.0 - 1.0, centerRaw, 1.0);\r\n#if UNITY_UV_STARTS_AT_TOP\r\nclipPos.y = -clipPos.y;\r\n#endif\r\nfloat4 worldPosRaw = mul(unity_MatrixInvVP, clipPos);\r\nfloat3 worldPos = worldPosRaw.xyz / worldPosRaw.w;\r\n\r\nfloat trueDistance = distance(worldPos, _WorldSpaceCameraPos);\r\nfloat distFactor = 1.0 - saturate(trueDistance / ThresholdDistance);\r\n\r\nfloat depthLerpT = distFactor * saturate(depthSoftness);\r\nfloat normalLerpT = distFactor * saturate(normalSoftness);\r\n\r\nfloat3 blurredNormal = 0;\r\nfloat blurredDepthSum = 0;\r\nfor (int j = 0; j < 9; j++)\r\n{\r\n    float2 bUV = UV + offsets[j] * TexelSize;\r\n    blurredNormal += SHADERGRAPH_SAMPLE_SCENE_NORMAL(bUV);\r\n    blurredDepthSum += LinearEyeDepth(SHADERGRAPH_SAMPLE_SCENE_DEPTH(bUV), _ZBufferParams);\r\n}\r\nblurredNormal /= 9.0;\r\nfloat blurredDepth = blurredDepthSum / 9.0;\r\n\r\nfloat3 centerNormal = SHADERGRAPH_SAMPLE_SCENE_NORMAL(UV);\r\nfloat2 noiseUV;\r\nif (abs(centerNormal.y) > 0.5) noiseUV = worldPos.xz; \r\nelse if (abs(centerNormal.x) > 0.5) noiseUV = worldPos.zy; \r\nelse noiseUV = worldPos.xy; \r\n\r\nfloat2 dx = ddx(UV * NoiseScale);\r\nfloat2 dy = ddy(UV * NoiseScale);\r\nfloat noiseVal = SAMPLE_TEXTURE2D_GRAD(NoiseTex, NoiseSampler, noiseUV * NoiseScale, dx, dy).r;\r\n\r\nfloat angle = noiseVal * 50.0;\r\nfloat2 randomDir = float2(cos(angle), sin(angle)); \r\nfloat2 distortionOffset = randomDir * Distortion * TexelSize;\r\ndistortedUV = UV + distortionOffset; \r\n\r\nfloat depthX = 0; float depthY = 0;\r\nfloat3 normalX = 0; float3 normalY = 0; \r\nfloat farDepth = centerDepth + 50.0;\r\n\r\nfloat distortedRaw = SHADERGRAPH_SAMPLE_SCENE_DEPTH(distortedUV);\r\nfloat distortedDepth = LinearEyeDepth(distortedRaw, _ZBufferParams);\r\n\r\nfor (int i = 0; i < 9; i++)\r\n{\r\n    float2 sampleUV = distortedUV + offsets[i] * TexelSize;\r\n    \r\n    float3 rawNormal = SHADERGRAPH_SAMPLE_SCENE_NORMAL(sampleUV);\r\n    float rawDepth = LinearEyeDepth(SHADERGRAPH_SAMPLE_SCENE_DEPTH(sampleUV), _ZBufferParams);\r\n    \r\n    float3 finalSampleNormal = lerp(rawNormal, blurredNormal, normalLerpT);\r\n    float finalSampleDepth = lerp(rawDepth, blurredDepth, depthLerpT);\r\n\r\n    bool isNeighborFloor = finalSampleNormal.y > 0.95; \r\n    float depth = isNeighborFloor ? farDepth : finalSampleDepth;\r\n\r\n    int row = (int)(i / 3);\r\n    int col = i % 3;\r\n    float kernelX = (col - 1) * (row == 1 ? 2.0 : 1.0);\r\n    float kernelY = (row - 1) * (col == 1 ? 2.0 : 1.0);\r\n\r\n    depthX += depth * kernelX;\r\n    depthY += depth * kernelY;\r\n    normalX += finalSampleNormal * kernelX;\r\n    normalY += finalSampleNormal * kernelY;\r\n}\r\n\r\ndepthEdge = sqrt(depthX * depthX + depthY * depthY);\r\ndepthEdge /= (distortedDepth * 0.1 + 0.5); \r\n\r\nfloat dynamicThreshold = lerp(MinThreshold, MaxThreshold, saturate(distortedDepth / ThresholdDistance));\r\ndepthEdge = saturate((depthEdge - dynamicThreshold) * DepthStrength);\r\n\r\nfloat normalEdgeVal = sqrt(dot(normalX, normalX) + dot(normalY, normalY));\r\nfloat relativeHeight = worldPos.y - _WorldSpaceCameraPos.y;\r\nfloat heightFactor = smoothstep(MinHeight, MaxHeight, relativeHeight);\r\nfloat heightMultiplier = lerp(MinMult, MaxMult, heightFactor);\r\n\r\nnormalEdge = smoothstep(NormalThreshold, NormalThreshold + 0.1, normalEdgeVal) * NormalStrength * heightMultiplier;\r\nnormalEdge = saturate(normalEdge); \r\n\r\nfloat finalEdge = max(depthEdge, normalEdge);\r\nfloat dryBrush = smoothstep(0.3, 0.7, noiseVal); \r\nfinalEdge *= dryBrush;\r\n\r\nfloat fadeRange = max(0.0001, LineFadeEnd - LineFadeStart);\r\nfloat distanceAlpha = saturate((LineFadeEnd - trueDistance) / fadeRange);\r\n\r\nOut = finalEdge * distanceAlpha;"
}

{
